<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin SolwedES - Edición de Contrato de Servicio
 *
 * @author    Solwed Desarrollo
 * @copyright 2025 Solwed
-->
<view>
    <columns>
        <group name="contract-info" numcolumns="12" title="contract-info">
            <column name="idcontacto" numcolumns="6" order="100">
                <widget type="autocomplete" fieldname="idcontacto" required="true" onclick="EditContacto">
                    <values source="contactos" fieldcode="idcontacto" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="idservicio" numcolumns="6" order="110">
                <widget type="select" fieldname="idservicio" required="true" onclick="EditServicio">
                    <values source="solwedes_servicios" fieldcode="id" fieldtitle="nombre"/>
                </widget>
            </column>
            <column name="estado" numcolumns="4" order="120">
                <widget type="select" fieldname="estado" required="true" translate="true">
                    <values title="activo">activo</values>
                    <values title="suspendido">suspendido</values>
                    <values title="cancelado">cancelado</values>
                    <values title="vencido">vencido</values>
                    <values title="pendiente">pendiente</values>
                </widget>
            </column>
            <column name="auto_renovar" numcolumns="4" order="130">
                <widget type="checkbox" fieldname="auto_renovar"/>
            </column>
        </group>
        <group name="dates" numcolumns="12" title="dates">
            <column name="fecha_inicio" numcolumns="3" order="100">
                <widget type="date" fieldname="fecha_inicio"/>
            </column>
            <column name="fecha_vencimiento" numcolumns="3" order="110">
                <widget type="date" fieldname="fecha_vencimiento"/>
            </column>
            <column name="fecha_ultimo_pago" numcolumns="3" order="120">
                <widget type="date" fieldname="fecha_ultimo_pago"/>
            </column>
            <column name="fecha_proximo_pago" numcolumns="3" order="130">
                <widget type="date" fieldname="fecha_proximo_pago"/>
            </column>
        </group>
        <group name="payment" numcolumns="12" title="payment">
            <column name="metodo_pago" numcolumns="4" order="100">
                <widget type="select" fieldname="metodo_pago" required="true" translate="true">
                    <values title="stripe">stripe</values>
                    <values title="transferencia">transferencia</values>
                    <values title="domiciliacion">domiciliacion</values>
                    <values title="manual">manual</values>
                </widget>
            </column>
            <column name="importe" numcolumns="4" order="110">
                <widget type="number" fieldname="importe" decimal="2"/>
            </column>
            <column name="referencia_externa" numcolumns="6" order="120">
                <widget type="text" fieldname="referencia_externa" maxlength="255">
                    <hint>ID de suscripción Stripe, referencia bancaria, etc.</hint>
                </widget>
            </column>
            <column name="stripe_customer_id" numcolumns="6" order="130">
                <widget type="text" fieldname="stripe_customer_id" maxlength="255" readonly="dinamic">
                    <hint>ID del cliente en Stripe (cus_xxx)</hint>
                </widget>
            </column>
        </group>
        <group name="notes" numcolumns="12" title="notes">
            <column name="notas" numcolumns="12" order="100">
                <widget type="textarea" fieldname="notas" rows="4"/>
            </column>
        </group>
        <group name="timestamps" numcolumns="12" title="dates">
            <column name="creation_date" numcolumns="6" order="100">
                <widget type="datetime" fieldname="creation_date" readonly="dinamic"/>
            </column>
            <column name="last_update" numcolumns="6" order="110">
                <widget type="datetime" fieldname="last_update" readonly="dinamic"/>
            </column>
        </group>
    </columns>
</view>
