<?xml version="1.0" encoding="UTF-8"?>
<!--
    Plugin SolwedES - Gestión de servicios SOLWED
    Vista de edición de configuración de servidores Plesk

    @author    Solwed Desarrollo
    @copyright 2025 Solwed
-->
<view>
    <columns>
        <group name="basic-info" numcolumns="12" title="basic-info">
            <column name="server_name" numcolumns="6" order="100">
                <widget type="text" fieldname="server_name" required="true" maxlength="100" />
            </column>
            <column name="activo" numcolumns="3" order="110">
                <widget type="checkbox" fieldname="activo" />
            </column>
        </group>

        <group name="connection" numcolumns="12" title="connection">
            <column name="server_url" numcolumns="8" order="200">
                <widget type="text" fieldname="server_url" required="true" maxlength="200" hint="plesk-server-url-hint" />
            </column>
            <column name="api_type" numcolumns="4" order="210">
                <widget type="select" fieldname="api_type" required="true">
                    <values title="REST API">rest</values>
                    <values title="XML-RPC">xmlrpc</values>
                </widget>
            </column>
            <column name="verify_ssl" numcolumns="4" order="220">
                <widget type="checkbox" fieldname="verify_ssl" />
            </column>
        </group>

        <group name="authentication" numcolumns="12" title="authentication">
            <column name="api_token" numcolumns="12" order="300">
                <widget type="password" fieldname="api_token" required="true" maxlength="500" hint="plesk-api-token-hint" />
            </column>
        </group>

        <group name="status" numcolumns="12" title="status">
            <column name="connection_status" numcolumns="4" order="400">
                <widget type="select" fieldname="connection_status" readonly="true">
                    <values title="connection-success">success</values>
                    <values title="connection-failed">failed</values>
                    <values title="connection-untested">untested</values>
                </widget>
            </column>
            <column name="last_connection_test" numcolumns="4" order="410">
                <widget type="datetime" fieldname="last_connection_test" readonly="true" />
            </column>
        </group>
    </columns>
</view>
