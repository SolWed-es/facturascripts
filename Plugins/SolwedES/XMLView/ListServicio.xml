<view>
    <columns>
        <column name="orden" order="100" display="center">
            <widget type="number" fieldname="orden" decimal="0"/>
        </column>
        <column name="nombre" order="110">
            <widget type="text" fieldname="nombre" onclick="EditServicio"/>
        </column>
        <column name="categoria" order="120">
            <widget type="text" fieldname="categoria"/>
        </column>
        <column name="stripe_product_id" order="130">
            <widget type="text" fieldname="stripe_product_id"/>
        </column>
        <column name="genera_suscripcion" display="center" order="140">
            <widget type="checkbox" fieldname="genera_suscripcion"/>
        </column>
        <column name="activo" display="center" order="150">
            <widget type="checkbox" fieldname="activo"/>
        </column>
        <column name="comprable" display="center" order="160">
            <widget type="checkbox" fieldname="comprable"/>
        </column>
    </columns>
    <rows>
        <row type="status" fieldname="activo">
            <option color="success">1</option>
            <option color="warning">0</option>
        </row>
        <row type="actions">
            <option icon="fa-solid fa-edit" label="edit" type="edit"/>
            <option icon="fa-solid fa-trash-alt" label="delete" type="delete" confirm="true"/>
        </row>
        <row type="statistics" fieldname="id">
            <option type="count" label="count"/>
        </row>
    </rows>
</view>
