{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
<div class="container-fluid mt-3">
    {# Tabs #}
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link {{ fsc.activeTab == 'dominios' ? 'active' : '' }}"
               href="{{ fsc.url() }}?activetab=dominios">
                <i class="fa-solid fa-globe me-1"></i>
                {{ trans('domains') }}
                <span class="badge bg-secondary ms-1">{{ fsc.dominios | length }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ fsc.activeTab == 'emails' ? 'active' : '' }}"
               href="{{ fsc.url() }}?activetab=emails">
                <i class="fa-solid fa-envelope me-1"></i>
                {{ trans('emails') }}
                <span class="badge bg-secondary ms-1">{{ fsc.emails | length }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ fsc.activeTab == 'webs' ? 'active' : '' }}"
               href="{{ fsc.url() }}?activetab=webs">
                <i class="fa-solid fa-globe me-1"></i>
                Webs
                <span class="badge bg-secondary ms-1">{{ fsc.webs | length }}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ fsc.activeTab == 'erps' ? 'active' : '' }}"
               href="{{ fsc.url() }}?activetab=erps">
                <i class="fa-solid fa-calculator me-1"></i>
                ERPs
                <span class="badge bg-secondary ms-1">{{ fsc.erps | length }}</span>
            </a>
        </li>
    </ul>

    {# Search bar #}
    <div class="card border-top-0 rounded-0 rounded-bottom mb-3">
        <div class="card-body py-2">
            <form method="get" action="{{ fsc.url() }}">
                <input type="hidden" name="activetab" value="{{ fsc.activeTab }}">
                <div class="input-group input-group-sm">
                    <input type="text" name="query" class="form-control" placeholder="{{ trans('search') }}..."
                           value="{{ fsc.query }}">
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="fa-solid fa-search"></i>
                    </button>
                    {% if fsc.query %}
                        <a class="btn btn-outline-danger" href="{{ fsc.url() }}?activetab={{ fsc.activeTab }}">
                            <i class="fa-solid fa-times"></i>
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    {# Tab content #}
    {% if fsc.activeTab == 'dominios' %}
        {{ _self.tabDominios(fsc) }}
    {% elseif fsc.activeTab == 'emails' %}
        {{ _self.tabEmails(fsc) }}
    {% elseif fsc.activeTab == 'webs' %}
        {{ _self.tabWebs(fsc) }}
    {% elseif fsc.activeTab == 'erps' %}
        {{ _self.tabERPs(fsc) }}
    {% endif %}

    {# Sync status footer #}
    <div class="text-muted small mt-2 mb-3">
        <i class="fa-solid fa-sync me-1"></i>
        Cache TTL:
        {% for key, ttl in fsc.syncStatus %}
            <span class="me-2">{{ key }}: {{ ttl > 0 ? ttl ~ 's' : 'expired' }}</span>
        {% endfor %}
        <span class="text-muted">(auto-sync every 30 min)</span>
    </div>
</div>
{% endblock %}

{# ─── DOMINIOS TAB ─────────────────────────────────────────── #}
{% macro tabDominios(fsc) %}
<div class="table-responsive">
    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>{{ trans('domain') }}</th>
                <th>{{ trans('status') }}</th>
                <th>{{ trans('expiration') }}</th>
                <th>Nameservers</th>
                <th class="text-center">Auto-renew</th>
            </tr>
        </thead>
        <tbody>
            {% for d in fsc.dominios %}
            <tr>
                <td>
                    <strong>{{ d.nombre }}</strong>
                </td>
                <td>
                    {% if d.estado == 'active' %}
                        <span class="badge bg-success">{{ d.estado }}</span>
                    {% elseif d.estado == 'expired' %}
                        <span class="badge bg-danger">{{ d.estado }}</span>
                    {% else %}
                        <span class="badge bg-warning">{{ d.estado }}</span>
                    {% endif %}
                </td>
                <td>{{ d.expiracion }}</td>
                <td>
                    {% if d.nameservers is iterable %}
                        <small class="text-muted">{{ d.nameservers | join(', ') }}</small>
                    {% endif %}
                </td>
                <td class="text-center">
                    {% if d.autorenew %}
                        <i class="fa-solid fa-check text-success"></i>
                    {% else %}
                        <i class="fa-solid fa-times text-muted"></i>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="fa-solid fa-globe fa-2x mb-2 d-block"></i>
                    {{ fsc.query ? 'No domains match your search' : 'No domains cached in Redis' }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}

{# ─── EMAILS TAB ───────────────────────────────────────────── #}
{% macro tabEmails(fsc) %}
<div class="table-responsive">
    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Email</th>
                <th>{{ trans('name') }}</th>
                <th>{{ trans('domain') }}</th>
                <th>Quota</th>
                <th>{{ trans('status') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for e in fsc.emails %}
            <tr>
                <td><strong>{{ e.email }}</strong></td>
                <td>{{ e.nombre }}</td>
                <td><small class="text-muted">{{ e.dominio }}</small></td>
                <td>
                    {% if e.cuota_mb > 0 %}
                        <div class="d-flex align-items-center">
                            <div class="progress flex-grow-1 me-2" style="height: 6px; min-width: 60px;">
                                {% set pct = e.uso_pct > 0 ? e.uso_pct : (e.cuota_mb > 0 ? (e.uso_mb / e.cuota_mb * 100) : 0) %}
                                <div class="progress-bar {{ pct > 80 ? 'bg-danger' : (pct > 60 ? 'bg-warning' : 'bg-success') }}"
                                     style="width: {{ pct }}%"></div>
                            </div>
                            <small class="text-muted text-nowrap">{{ e.uso_mb | round }}MB / {{ e.cuota_mb }}MB</small>
                        </div>
                    {% else %}
                        <small class="text-muted">-</small>
                    {% endif %}
                </td>
                <td>
                    <span class="badge {{ e.estado == 'active' ? 'bg-success' : 'bg-secondary' }}">{{ e.estado }}</span>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="fa-solid fa-envelope fa-2x mb-2 d-block"></i>
                    {{ fsc.query ? 'No mailboxes match your search' : 'No mailboxes cached in Redis' }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}

{# ─── WEBS TAB ─────────────────────────────────────────────── #}
{% macro tabWebs(fsc) %}
<div class="table-responsive">
    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>{{ trans('domain') }}</th>
                <th>{{ trans('status') }}</th>
                <th>IP</th>
                <th>SSL</th>
                <th>PHP</th>
            </tr>
        </thead>
        <tbody>
            {% for w in fsc.webs %}
            <tr>
                <td>
                    <strong>{{ w.dominio }}</strong>
                    <br><small class="text-muted">{{ w.hosting_type }}</small>
                </td>
                <td>
                    <span class="badge {{ w.estado == 'active' ? 'bg-success' : 'bg-secondary' }}">{{ w.estado }}</span>
                </td>
                <td><small class="text-muted">{{ w.ip }}</small></td>
                <td>
                    {% if w.ssl_activo %}
                        <i class="fa-solid fa-lock text-success" title="SSL active"></i>
                        {% if w.ssl_expira %}
                            <small class="text-muted ms-1">{{ w.ssl_expira }}</small>
                        {% endif %}
                    {% else %}
                        <i class="fa-solid fa-lock-open text-danger" title="No SSL"></i>
                    {% endif %}
                </td>
                <td><small>{{ w.php_version }}</small></td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="fa-solid fa-globe fa-2x mb-2 d-block"></i>
                    {{ fsc.query ? 'No sites match your search' : 'No sites cached in Redis' }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}

{# ─── ERPs TAB ─────────────────────────────────────────────── #}
{% macro tabERPs(fsc) %}
<div class="table-responsive">
    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>{{ trans('domain') }}</th>
                <th>{{ trans('status') }}</th>
                <th>IP</th>
                <th>SSL</th>
                <th>PHP</th>
            </tr>
        </thead>
        <tbody>
            {% for e in fsc.erps %}
            <tr>
                <td><strong>{{ e.dominio }}</strong></td>
                <td>
                    <span class="badge {{ e.estado == 'active' ? 'bg-success' : 'bg-secondary' }}">{{ e.estado }}</span>
                </td>
                <td><small class="text-muted">{{ e.ip }}</small></td>
                <td>
                    {% if e.ssl_activo %}
                        <i class="fa-solid fa-lock text-success"></i>
                    {% else %}
                        <i class="fa-solid fa-lock-open text-danger"></i>
                    {% endif %}
                </td>
                <td><small>{{ e.php_version }}</small></td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">
                    <i class="fa-solid fa-calculator fa-2x mb-2 d-block"></i>
                    {{ fsc.query ? 'No ERPs match your search' : 'No ERP installations cached in Redis' }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endmacro %}
