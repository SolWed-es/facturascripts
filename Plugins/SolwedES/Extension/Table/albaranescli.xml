<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin SolwedES - Columnas de control de cobro Stripe sobre albaranes de cliente.
 * Se fusionan con la tabla albaranescli del core (no la reemplazan).
-->
<table>
    <column>
        <name>pc_paid</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>pc_created</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>pc_impago</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>pc_payment_intent_stripe</name>
        <type>character varying(255)</type>
    </column>
</table>
