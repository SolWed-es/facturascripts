<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Plugin SolwedES - Precios de Servicios (múltiples períodos de facturación)
 *
 * @author    Solwed Desarrollo
 * @copyright 2025 Solwed
-->
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>idservicio</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>periodo</name>
        <type>character varying(20)</type>
        <null>NO</null>
    </column>
    <column>
        <name>meses</name>
        <type>integer</type>
        <default>1</default>
    </column>
    <column>
        <name>precio</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>stripe_price_id</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>descuento_label</name>
        <type>character varying(50)</type>
    </column>
    <column>
        <name>activo</name>
        <type>boolean</type>
        <default>true</default>
    </column>
    <column>
        <name>orden</name>
        <type>integer</type>
        <default>0</default>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>last_update</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>solwedes_servicios_precios_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>solwedes_servicios_precios_servicio_fk</name>
        <type>FOREIGN KEY (idservicio) REFERENCES solwedes_servicios (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>solwedes_servicios_precios_unique</name>
        <type>UNIQUE (idservicio, periodo)</type>
    </constraint>
</table>
