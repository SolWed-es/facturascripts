<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>idacceso</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>cache_key</name>
        <type>character varying(100)</type>
        <null>NO</null>
    </column>
    <column>
        <name>data</name>
        <type>text</type>
    </column>
    <column>
        <name>expires_at</name>
        <type>timestamp</type>
        <null>NO</null>
    </column>
    <column>
        <name>created_at</name>
        <type>timestamp</type>
        <default>CURRENT_TIMESTAMP</default>
    </column>
    <constraint>
        <name>solwedes_plesk_cache_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>solwedes_plesk_cache_unique</name>
        <type>UNIQUE (idacceso, cache_key)</type>
    </constraint>
    <constraint>
        <name>solwedes_plesk_cache_fk</name>
        <type>FOREIGN KEY (idacceso) REFERENCES solwedes_accesos_servicios (id) ON DELETE CASCADE</type>
    </constraint>
</table>
