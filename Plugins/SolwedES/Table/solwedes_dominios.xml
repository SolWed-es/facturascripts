<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>idcontacto</name>
        <type>integer</type>
    </column>
    <column>
        <name>nombre</name>
        <type>character varying(100)</type>
    </column>
    <column>
        <name>tld</name>
        <type>character varying(20)</type>
        <null>NO</null>
    </column>
    <column>
        <name>dondominio_id</name>
        <type>integer</type>
    </column>
    <column>
        <name>fecha_registro</name>
        <type>date</type>
    </column>
    <column>
        <name>fecha_expiracion</name>
        <type>date</type>
    </column>
    <column>
        <name>estado</name>
        <type>character varying(30)</type>
        <default>'active'</default>
    </column>
    <column>
        <name>gestionado_solwed</name>
        <type>boolean</type>
        <default>true</default>
    </column>
    <column>
        <name>privacidad_whois</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>bloqueado</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <column>
        <name>usado_por</name>
        <type>character varying(50)</type>
    </column>
    <column>
        <name>idsuscripcion</name>
        <type>integer</type>
    </column>
    <column>
        <name>observaciones</name>
        <type>text</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>last_update</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>solwedes_dominios_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>solwedes_dominios_contacto_fk</name>
        <type>FOREIGN KEY (idcontacto) REFERENCES contactos (idcontacto) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>solwedes_dominios_suscripcion_fk</name>
        <type>FOREIGN KEY (idsuscripcion) REFERENCES solwedes_suscripciones (id) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>solwedes_dominios_nombre_tld_unique</name>
        <type>UNIQUE (nombre, tld)</type>
    </constraint>
</table>
