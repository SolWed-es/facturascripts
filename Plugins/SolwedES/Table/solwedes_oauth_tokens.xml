<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>idcontacto</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>provider</name>
        <type>character varying(30)</type>
        <null>NO</null>
    </column>
    <column>
        <name>alias</name>
        <type>character varying(100)</type>
        <default>'default'</default>
    </column>
    <column>
        <name>access_token</name>
        <type>text</type>
        <null>NO</null>
    </column>
    <column>
        <name>refresh_token</name>
        <type>text</type>
    </column>
    <column>
        <name>expires_at</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>scopes</name>
        <type>text</type>
    </column>
    <column>
        <name>provider_user_id</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>provider_email</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>metadata</name>
        <type>text</type>
    </column>
    <column>
        <name>last_refreshed</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>last_update</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>solwedes_oauth_tokens_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>solwedes_oauth_tokens_contacto_fk</name>
        <type>FOREIGN KEY (idcontacto) REFERENCES contactos (idcontacto) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>solwedes_oauth_tokens_unique</name>
        <type>UNIQUE (idcontacto, provider, alias)</type>
    </constraint>
</table>
