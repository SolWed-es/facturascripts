<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
    </column>
    <column>
        <name>codproveedor</name>
        <type>character varying(10)</type>
        <null>NO</null>
    </column>
    <column>
        <name>concepto</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>importe</name>
        <type>double precision</type>
        <default>0</default>
    </column>
    <column>
        <name>moneda</name>
        <type>character varying(5)</type>
        <default>'EUR'</default>
    </column>
    <column>
        <name>intervalo</name>
        <type>character varying(20)</type>
        <default>'month'</default>
    </column>
    <column>
        <name>estado</name>
        <type>character varying(20)</type>
        <default>'activa'</default>
    </column>
    <column>
        <name>fecha_inicio</name>
        <type>date</type>
    </column>
    <column>
        <name>fecha_proximo_pago</name>
        <type>date</type>
    </column>
    <column>
        <name>fecha_ultimo_pago</name>
        <type>date</type>
    </column>
    <column>
        <name>metodo_pago</name>
        <type>character varying(20)</type>
        <default>'domiciliacion'</default>
    </column>
    <column>
        <name>referencia_externa</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>auto_renovar</name>
        <type>boolean</type>
        <default>true</default>
    </column>
    <column>
        <name>notas</name>
        <type>text</type>
    </column>
    <column>
        <name>creation_date</name>
        <type>timestamp</type>
    </column>
    <column>
        <name>last_update</name>
        <type>timestamp</type>
    </column>
    <constraint>
        <name>solwedes_suscripciones_compra_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>solwedes_suscripciones_compra_proveedor_fk</name>
        <type>FOREIGN KEY (codproveedor) REFERENCES proveedores (codproveedor) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>
