<?xml version="1.0" encoding="UTF-8"?>
<!--
    SolwedFacturasEmail - Tabla de log de emails procesados
    Copyright (C) 2026 SOLWED <admin@solwed.es>
-->
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>fecha</name>
        <type>timestamp</type>
        <null>NO</null>
    </column>
    <column>
        <name>email_from</name>
        <type>character varying(255)</type>
        <null>NO</null>
    </column>
    <column>
        <name>email_subject</name>
        <type>character varying(500)</type>
    </column>
    <column>
        <name>email_uid</name>
        <type>character varying(100)</type>
    </column>
    <column>
        <name>pdf_filename</name>
        <type>character varying(255)</type>
    </column>
    <column>
        <name>estado</name>
        <type>character varying(20)</type>
        <default>'pendiente'</default>
    </column>
    <column>
        <name>idfactura</name>
        <type>integer</type>
    </column>
    <column>
        <name>codproveedor</name>
        <type>character varying(10)</type>
    </column>
    <column>
        <name>idfile</name>
        <type>integer</type>
    </column>
    <column>
        <name>error_msg</name>
        <type>text</type>
    </column>
    <column>
        <name>ocr_text</name>
        <type>text</type>
    </column>
    <column>
        <name>parsed_data</name>
        <type>text</type>
    </column>
    <constraint>
        <name>facturas_email_log_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
</table>
