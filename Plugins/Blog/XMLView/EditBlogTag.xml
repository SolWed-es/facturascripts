<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <!-- Hidden ID -->
        <column name="code" display="none" order="10">
            <widget type="hidden" fieldname="id"/>
        </column>

        <group name="basic-info" title="basic-information" numcolumns="12" order="100">
            <column name="name" title="name" numcolumns="6" order="110">
                <widget type="text" fieldname="name" maxlength="50" icon="fa-solid fa-tag" required="true"/>
            </column>
            <column name="slug" title="slug" numcolumns="6" order="120">
                <widget type="text" fieldname="slug" maxlength="50" icon="fa-solid fa-link"/>
            </column>
        </group>
    </columns>
</view>
