<?xml version="1.0" encoding="UTF-8"?>
<!--
 * Settings view for Blog Plugin
 *
 * @author Your Name
-->
<view>
    <columns>
        <!-- AI Providers Configuration -->
        <group name="ai-providers" title="AI Providers Configuration" numcolumns="12" order="100">
            <column name="ai_api_key_groq" title="Groq API Key" numcolumns="12" order="110">
                <widget type="text" fieldname="ai_api_key_groq" maxlength="255"
                        hint="Get your free API key at https://console.groq.com/ (14,400 requests/day free)"
                        icon="fa-solid fa-key"/>
            </column>
            <column name="ai_api_key_cohere" title="Cohere API Key" numcolumns="12" order="120">
                <widget type="text" fieldname="ai_api_key_cohere" maxlength="255"
                        hint="Get your free API key at https://dashboard.cohere.com/ (1,000 requests/month free)"
                        icon="fa-solid fa-key"/>
            </column>
        </group>

        <!-- SEO Configuration -->
        <group name="seo-config" title="SEO Configuration" numcolumns="12" order="200">
            <column name="default_ai_provider" title="Default AI Provider" numcolumns="6" order="210">
                <widget type="select" fieldname="default_ai_provider">
                    <values title="Groq">groq</values>
                    <values title="Cohere">cohere</values>
                </widget>
            </column>
        </group>
    </columns>
</view>
