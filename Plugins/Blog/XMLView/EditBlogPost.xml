<?xml version="1.0" encoding="UTF-8"?>
<view>
    <columns>
        <!-- Hidden ID -->
        <column name="code" display="none" order="10">
            <widget type="hidden" fieldname="id"/>
        </column>

        <!-- Basic Information Group -->
        <group name="basic-info" title="basic-information" numcolumns="12" order="100">
            <column name="title" title="title" numcolumns="8" order="110">
                <widget type="text" fieldname="title" maxlength="255" icon="fa-solid fa-heading" required="true"/>
            </column>
            <column name="slug" title="slug" numcolumns="4" order="120">
                <widget type="text" fieldname="slug" maxlength="255" icon="fa-solid fa-link"/>
            </column>
            <column name="status" title="status" numcolumns="3" order="130">
                <widget type="select" fieldname="status" required="true">
                    <values title="draft">draft</values>
                    <values title="published">published</values>
                </widget>
            </column>
            <column name="author" title="author" numcolumns="3" order="140">
                <widget type="text" fieldname="author" maxlength="50" icon="fa-solid fa-user"/>
            </column>
            <column name="published-at" title="published-date" numcolumns="3" order="150">
                <widget type="datetime" fieldname="published_at"/>
            </column>
            <column name="featured-image" title="featured-image" numcolumns="12" order="160">
                <widget type="file" fieldname="featured_image" accept="image/jpeg,image/png,image/gif,image/webp" icon="fa-solid fa-image"/>
            </column>
        </group>

        <!-- Content Group -->
        <group name="content" title="content" numcolumns="12" order="200">
            <column name="excerpt" title="excerpt" numcolumns="12" order="210">
                <widget type="textarea" fieldname="excerpt" maxlength="500"/>
            </column>
            <column name="content-text" title="content" numcolumns="12" order="220">
                <widget type="textarea" fieldname="content"/>
            </column>
        </group>

        <!-- SEO Group -->
        <group name="seo" title="seo-metadata" numcolumns="12" order="300">
            <column name="meta-title" title="meta-title" numcolumns="12" order="310">
                <widget type="text" fieldname="meta_title" maxlength="255" icon="fa-solid fa-heading"/>
            </column>
            <column name="meta-description" title="meta-description" numcolumns="12" order="320">
                <widget type="textarea" fieldname="meta_description" maxlength="500"/>
            </column>
            <column name="meta-keywords" title="meta-keywords" numcolumns="12" order="330">
                <widget type="text" fieldname="meta_keywords" maxlength="255" icon="fa-solid fa-tags"/>
            </column>
        </group>

        <!-- Timestamps -->
        <group name="timestamps" title="timestamps" numcolumns="12" order="400">
            <column name="created-at" title="created-at" numcolumns="6" order="410">
                <widget type="datetime" fieldname="created_at" readonly="true"/>
            </column>
            <column name="updated-at" title="updated-at" numcolumns="6" order="420">
                <widget type="datetime" fieldname="updated_at" readonly="true"/>
            </column>
        </group>
    </columns>
</view>
