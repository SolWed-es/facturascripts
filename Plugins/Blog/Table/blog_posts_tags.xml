<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>post_id</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>tag_id</name>
        <type>integer</type>
        <null>NO</null>
    </column>

    <constraint>
        <name>blog_posts_tags_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>

    <constraint>
        <name>ca_blog_posts_tags_posts</name>
        <type>FOREIGN KEY (post_id) REFERENCES blog_posts (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>

    <constraint>
        <name>ca_blog_posts_tags_tags</name>
        <type>FOREIGN KEY (tag_id) REFERENCES blog_tags (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>

    <constraint>
        <name>unique_blog_post_tag</name>
        <type>UNIQUE (post_id, tag_id)</type>
    </constraint>
</table>
