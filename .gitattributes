# Normalize line endings to LF on commit, keep native on checkout
* text=auto eol=lf

# Ensure these are always LF
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.twig text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.pdf binary
