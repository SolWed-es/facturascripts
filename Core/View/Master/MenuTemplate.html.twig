{#
/**
 * SolwedShadcn — MenuTemplate base
 * Layout principal: sidebar izquierdo + header top + contenido
 * Sin Bootstrap CSS. Solo Tailwind + bootstrap-compat + Bootstrap JS (modals/dropdowns)
 */
#}
{% import 'Macro/GoogleTagManager.html.twig' as GoogleTagManager %}
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="{{ constant('FS_LANG') | slice(0, 2) }}"
      xml:lang="{{ constant('FS_LANG') | slice(0, 2) }}">
<head>
    {{ GoogleTagManager.head() }}
    {% for includeView in getIncludeViews('MenuTemplate', 'HeadFirst') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% block meta %}
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <title>{{ fsc.title }}</title>
        <meta name="description" content="{{ trans('meta-description') }}"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <meta name="generator" content="FacturaSolwed"/>
        <meta name="robots" content="noindex"/>
        <link rel="manifest" href="{{ asset('Core/Assets/manifest.json') }}"/>
        <meta name="theme-color" content="#2E3536"/>
        <meta name="mobile-web-app-capable" content="yes"/>
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
    {% endblock %}
    {% block icons %}
        <link rel="shortcut icon" href="{{ asset('Dinamic/Assets/Images/favicon.ico') }}"/>
        <link rel="apple-touch-icon" sizes="180x180"
              href="{{ asset('Dinamic/Assets/Images/apple-icon-180x180.png') }}"/>
    {% endblock %}
    {% for includeView in getIncludeViews('MenuTemplate', 'CssBefore') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% block css %}
        {# Fuentes locales: Chakra Petch + Jura #}
        <link rel="stylesheet" href="{{ asset('Dinamic/Assets/CSS/fonts.css') }}?v={{ 'now' | date('ymdHi') }}"/>
        {# Bootstrap 5 dentro de @layer base → prioridad baja #}
        <style>@import url("{{ asset('node_modules/bootstrap/dist/css/bootstrap.min.css') }}") layer(bootstrap);</style>
        {# Tema SOLWED shadcn-ui — fuera de layer → siempre gana #}
        <link rel="stylesheet" href="{{ asset('Dinamic/Assets/CSS/solwed-theme.css') }}?v={{ 'now' | date('ymdHi') }}"/>
    {% endblock %}
    {# Lucide Icons — local #}
    <script src="{{ asset('Dinamic/Assets/JS/lucide.min.js') }}"></script>
    {# Adds custom CSS assets #}
    {% for css in assetManager.get('css') %}
        <link rel="stylesheet" href="{{ css }}"/>
    {% endfor %}
    {% for includeView in getIncludeViews('MenuTemplate', 'CssAfter') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% for includeView in getIncludeViews('MenuTemplate', 'JsHeadBefore') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% block javascripts %}
        <script src="{{ asset('Dinamic/Assets/JS/ThemeToggle.js') }}?v={{ 'now' | date('ymdHi') }}"></script>
        <script src="{{ asset('node_modules/jquery/dist/jquery.min.js') }}"></script>
        {# Bootstrap JS bundle — SOLO para modals, dropdowns, tooltips, toasts #}
        <script src="{{ asset('node_modules/bootstrap/dist/js/bootstrap.bundle.min.js') }}?v=5"></script>
        <script src="{{ asset('node_modules/pace-js/pace.min.js') }}"></script>
        <script src="{{ asset('node_modules/@fortawesome/fontawesome-free/js/all.min.js') }}?v=6"></script>
        <script src="{{ asset('Dinamic/Assets/JS/Custom.js') }}?v={{ 'now' | date('ymdHi') }}"></script>
    {% endblock %}
    {# Adds custom JS assets #}
    {% for js in assetManager.get('js') %}
        <script src="{{ js }}"></script>
    {% endfor %}
    {% for includeView in getIncludeViews('MenuTemplate', 'JsHeadAfter') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% if debugBarRender %}
        {{ debugBarRender.renderHead() | raw }}
    {% endif %}
    {% for includeView in getIncludeViews('MenuTemplate', 'HeadEnd') %}
        {% include includeView['path'] %}
    {% endfor %}
</head>
{% block fullBody %}
    <body class="bg-background text-foreground font-sans antialiased">
    {{ GoogleTagManager.body() }}
    {% for includeView in getIncludeViews('MenuTemplate', 'BodyFirst') %}
        {% include includeView['path'] %}
    {% endfor %}

    {# Overlay para sidebar en móvil #}
    <div id="sidebarOverlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <div class="solwed-layout">
        {% block navbar %}
            {# ===== SIDEBAR ===== #}
            <aside id="solwedSidebar" class="solwed-sidebar d-print-none">
                {# Brand: solo nombre empresa centrado #}
                <div class="sidebar-brand">
                    <a href="{{ asset(fsc.user.homepage) }}" title="{{ trans('homepage') }}">
                        <span class="sidebar-brand-name">{{ fsc.empresa.nombrecorto | raw }}</span>
                    </a>
                </div>

                {# Navegación sidebar #}
                <nav class="sidebar-nav">
                    {% import 'Macro/Menu.html.twig' as macros %}
                    {% for menuItem in menuManager.getMenu() %}
                        {{ macros.showMenu(menuItem) }}
                    {% endfor %}
                </nav>

                {# Powered by SOLWED #}
                <div class="sidebar-powered">
                    <a href="https://solwed.es" rel="nofollow" target="_blank">
                        <span>Powered by</span>
                        <img src="{{ asset('Core/Assets/Images/logo-dark.png') }}" class="sidebar-powered-logo solwed-logo-light" alt="SOLWED"/>
                        <img src="{{ asset('Core/Assets/Images/logo-white.png') }}" class="sidebar-powered-logo solwed-logo-dark" alt="SOLWED"/>
                    </a>
                </div>
            </aside>
        {% endblock %}

        {# ===== CONTENIDO PRINCIPAL ===== #}
        <div class="solwed-main">
            {# Header top bar #}
            {% include 'Master/AppHeader.html.twig' %}

            {# Mensajes y contenido #}
            <div class="flex-1 overflow-auto">
                {% block messages %}
                    {% include 'Macro/Toasts.html.twig' %}
                    {% from 'Macro/Utils.html.twig' import message as showMessage %}
                    <div class="px-4 pt-3">
                        {{ showMessage(log, ['error', 'critical'], 'danger') }}
                        {{ showMessage(log, ['warning'], 'warning') }}
                        {{ showMessage(log, ['notice'], 'success') }}
                        {{ showMessage(log, ['info'], 'info') }}
                    </div>
                {% endblock %}

                {% block bodyHeaderOptions %}
                {% endblock %}

                {% block body %}
                {% endblock %}
            </div>
        </div>
    </div>

    {# Sidebar JS #}
    <script src="{{ asset('Dinamic/Assets/JS/sidebar.js') }}?v={{ 'now' | date('ymdHi') }}"></script>
    <script src="{{ asset('Dinamic/Assets/JS/theme.js') }}?v={{ 'now' | date('ymdHi') }}"></script>

    {% for includeView in getIncludeViews('MenuTemplate', 'JsFooter') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% for includeView in getIncludeViews('MenuTemplate', 'BodyEnd') %}
        {% include includeView['path'] %}
    {% endfor %}
    {% if debugBarRender %}
        {{ debugBarRender.render() | raw }}
    {% endif %}
    </body>
{% endblock %}
</html>
<!-- execution time: {{ executionTime() }} s -->
