{# SolwedShadcn — Vista HTML de email enviado #}
{% set firstView = fsc.views | first %}
{% set model = firstView.model %}

<div class="card-shadcn mb-4" id="email-html">
    <div class="p-6">
        <div class="text-center">
            <h4 class="mb-3">{{ trans('loading') }}</h4>
            <i data-lucide="loader-2" class="w-12 h-12 text-muted-foreground animate-spin mx-auto"></i>
        </div>
    </div>
</div>

<script>
    let formData = new FormData();
    formData.append('action', 'getHtml');
    formData.append('code', '{{ model.primaryColumnValue() }}');

    fetch('{{ fsc.url() }}', {
        method: 'POST',
        body: formData,
    }).then(function (response) {
        if (response.ok) {
            return response.json();
        }
        return Promise.reject(response);
    }).then(function (data) {
        if (data.getHtml) {
            $('#email-html').html('');

            let div = document.createElement('div');
            div.className = 'message-content';
            $('#email-html').prepend(div);

            let frame = document.createElement('iframe');
            frame.setAttribute('sandbox', '');
            frame.setAttribute('referrerpolicy', 'no-referrer');
            frame.className = 'w-100 border-0';
            frame.style.minHeight = '70vh';
            frame.srcdoc = data.html;

            div.appendChild(frame);
        }
    }).catch(function (error) {
        alert('error getHtml');
        console.warn(error);
    });
</script>
