{% extends "Master/MenuTemplate.html.twig" %}
{% block body %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

<div class="container w-100">
  <div id="aviso" class="alert alert-danger alert-dismissible fade show" role="alert" style="display: none;">
    ¡Debes seleccionar al menos un presupuesto para pagar!
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <div id="copiarEnlaceAviso" class="alert alert-success alert-dismissible fade show" role="alert" style="display: none;">
    El enlace se ha copiado al portapapeles.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  <div id="correoEnviadoAviso" class="alert alert-success alert-dismissible fade show" role="alert" style="display: none;">
    El correo se ha enviado correctamente.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <h2>Selecciona los presupuestos a pagar</h2>
  <div class="table-responsive w-100">
    <button id="btnPagar" class="btn btn-primary mt-2 mb-2"><i class="fas fa-eye"></i> Vista previa</button>
    {# <button id="enviarCorreoGeneral" class="btn btn-primary mt-2 mb-2"><i class="fas fa-envelope"></i> Enviar correo electrónico</button> #}
    <button id="copiarEnlaceGeneral" class="btn btn-secondary mt-2 mb-2"><i class="fas fa-clipboard"></i> Copiar enlace</button>
    <table class="table table-striped table-hover w-100">
      <thead>
        <tr>
          <th><input type="checkbox" id="checkTodos"></th>
          <th>Presupuesto</th>
          <th>Cliente</th>
          <th>Pagado</th>
          <th>A pagar</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for presupuesto in fsc.presupuestos %}
          <tr data-bs-toggle="collapse" data-bs-target="#{{presupuesto.codigo}}" class="accordion-toggle">
            <td><input type="checkbox" class="checkFila" data-target="{{presupuesto.codigo}}"></td>
            <td>{{presupuesto.codigo}}</td>
            {% for cliente in fsc.clientes %}
              {% if cliente.codcliente == presupuesto.codcliente %}
                <td>{{ cliente.nombre }}</td>
              {% endif %}
            {% endfor %}
            {% if attribute(fsc.pagado, presupuesto.codigo) %}
              <td class="text-success">{{ attribute(fsc.pagado, presupuesto.codigo) }}</td>
            {% else %}
              <td class="text-success">0,00 €</td>
            {% endif %}
            {% if attribute(fsc.nopagado, presupuesto.codigo) %}
              <td class="text-danger">{{ attribute(fsc.nopagado, presupuesto.codigo) }}</td>
            {% else %}
              <td class="text-danger">0,00 €</td>
            {% endif %}
            <td><i class="bi bi-caret-down-fill"></i></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    var checkTodos = document.getElementById('checkTodos');
    var aviso = document.getElementById('aviso');
    var copiarEnlaceAviso = document.getElementById('copiarEnlaceAviso');

    checkTodos.addEventListener('change', function() {
        var checkboxes = document.querySelectorAll('.checkFila');
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = checkTodos.checked;
            var parentCodigo = checkbox.dataset.target;
            var checkboxesSubFilaParent = document.querySelectorAll('.checkFila[data-parent="' + parentCodigo + '"]');
            checkboxesSubFilaParent.forEach(function(subcheckbox) {
                subcheckbox.checked = checkbox.checked;
            });
        });
    });

    var btnPagar = document.getElementById('btnPagar');
    btnPagar.addEventListener('click', function() {
        var checkboxesRecibos = document.querySelectorAll('.checkFila:checked');
        if (checkboxesRecibos.length === 0) {
            aviso.style.display = 'block'; 
            setTimeout(function() {
                aviso.style.display = 'none'; 
            }, 3000);
            return; 
        }
        
        var idsPresupuestos = [];
        var nombrespresupuestos = [];
        checkboxesRecibos.forEach(function(checkbox) {
            idsPresupuestos.push(checkbox.dataset.idpresupuesto);
            var parentCodigo = checkbox.dataset.target;
            var nombrepresupuesto = document.querySelector('.checkFila[data-target="' + parentCodigo + '"]').parentNode.nextElementSibling.textContent;
            nombrespresupuestos.push(nombrepresupuesto);
        });
        var url = 'ListPasarelaPago?presupuestos=' + nombrespresupuestos.join(',');
        window.location.href = url;
    });

