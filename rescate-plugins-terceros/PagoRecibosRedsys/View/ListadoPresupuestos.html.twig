    function construirURLPago() {
        var checkboxesRecibos = document.querySelectorAll('.checkFila:checked');
        var idsPresupuestos = [];
        var nombrespresupuestos = [];
        checkboxesRecibos.forEach(function(checkbox) {
            idsPresupuestos.push(checkbox.dataset.idpresupuesto);
            var parentCodigo = checkbox.dataset.target;
            var nombrepresupuesto = document.querySelector('.checkFila[data-target="' + parentCodigo + '"]').parentNode.nextElementSibling.textContent;
            nombrespresupuestos.push(nombrepresupuesto);
        });
        if (window.location.href.includes("vencidas=0")) {
            return window.location.href.replace("ListSeleccionPresupuestos", "") + 'ListPasarelaPago?presupuestos=' + nombrespresupuestos.join(',');
        } else {
            return window.location.href.replace("ListSeleccionPresupuestos", "") + 'ListPasarelaPago?presupuestos=' + nombrespresupuestos.join(',');
        }
    }

