    function copiarEnlaceSeleccionados() {
        var checkboxesRecibos = document.querySelectorAll('.checkFila:checked');
        var idsPresupuestos = [];
        var nombrespresupuestos = [];
        checkboxesRecibos.forEach(function(checkbox) {
            idsPresupuestos.push(checkbox.dataset.idpresupuesto);
            var parentCodigo = checkbox.dataset.target;
            var nombrepresupuesto = document.querySelector('.checkFila[data-target="' + parentCodigo + '"]').parentNode.nextElementSibling.textContent;
            nombrespresupuestos.push(nombrepresupuesto);
        });
        var url = window.location.href.replace("ListSeleccionPresupuestos", "") + 'ListPasarelaPago?presupuestos=' + nombrespresupuestos.join(',');

        if (checkboxesRecibos.length === 0) {
            aviso.style.display = 'block';
            setTimeout(function() {
                aviso.style.display = 'none';
            }, 3000);
            return;
        }

        var elementoTemporal = document.createElement("input");
        document.body.appendChild(elementoTemporal);
        elementoTemporal.setAttribute('value', url);
        elementoTemporal.select();
        document.execCommand("copy");
        document.body.removeChild(elementoTemporal);

        copiarEnlaceAviso.style.display = 'block';
    }


    document.getElementById('copiarEnlaceGeneral').addEventListener('click', function(evento) {
        evento.preventDefault();
        copiarEnlaceSeleccionados();
    });

    function distinct(array) {
        return array.filter((value, index, self) => self.indexOf(value) === index);
    }

    document.getElementById('enviarCorreoGeneral').addEventListener('click', function(evento) {
        evento.preventDefault();

        var clientes = [];
        var correos = [];
        var totalAPagar = calcularTotalAPagar();
        var urlPago = construirURLPago();

        var checkboxesRecibos = document.querySelectorAll('.checkFila:checked');
        checkboxesRecibos.forEach(function(checkbox) {
            var parentCodigo = checkbox.dataset.target;
            var presupuestoRow = document.querySelector('.checkFila[data-target="' + parentCodigo + '"]').parentNode.parentNode;
            var clienteNombre = presupuestoRow.querySelector('td:nth-child(3)').textContent.trim();
            var clienteCorreo = presupuestoRow.querySelector('.enviarMail').dataset.correo.trim();
            clientes.push(clienteNombre);
            correos.push(clienteCorreo);
        });

        if (checkboxesRecibos.length === 0) {
            aviso.style.display = 'block';
            setTimeout(function() {
                aviso.style.display = 'none';
            }, 3000);
            return;
        }

        clientes = distinct(clientes);
        correos = distinct(correos);

        var form = document.createElement('form');
        form.setAttribute('method', 'post');
        form.setAttribute('action', 'EnviarCorreo');

        var inputNombre = document.createElement('input');
        inputNombre.setAttribute('type', 'hidden');
        inputNombre.setAttribute('name', 'name');
        inputNombre.setAttribute('value', clientes.join(','));
        form.appendChild(inputNombre);

        var inputCorreo = document.createElement('input');
        inputCorreo.setAttribute('type', 'hidden');
        inputCorreo.setAttribute('name', 'email');
        inputCorreo.setAttribute('value', correos.join(','));
        form.appendChild(inputCorreo);

        var inputAmount = document.createElement('input');
        inputAmount.setAttribute('type', 'hidden');
        inputAmount.setAttribute('name', 'amount');
        inputAmount.setAttribute('value', totalAPagar);
        form.appendChild(inputAmount);

        var inputURLPago = document.createElement('input');
        inputURLPago.setAttribute('type', 'hidden');
        inputURLPago.setAttribute('name', 'url');
        inputURLPago.setAttribute('value', urlPago);
        form.appendChild(inputURLPago);

        document.body.appendChild(form);
        form.submit();
    });
});
</script>

<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js" integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3" crossorigin="anonymous"></script>
