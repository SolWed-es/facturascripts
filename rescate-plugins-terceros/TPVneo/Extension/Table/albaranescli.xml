<table>
    <column>
        <name>idcaja</name>
        <type>int</type>
    </column>
    <column>
        <name>idtpv</name>
        <type>int</type>
    </column>
    <column>
        <name>tpv_efectivo</name>
        <type>double precision</type>
    </column>
    <column>
        <name>tpv_cambio</name>
        <type>double precision</type>
    </column>
    <column>
        <name>tpv_venta</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <constraint>
        <name>ca_albaranescli_tpvsneo_cajas</name>
        <type>FOREIGN KEY (idcaja) REFERENCES tpvsneo_cajas (idcaja) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_albaranescli_tpvsneo_set_null</name>
        <type>FOREIGN KEY (idtpv) REFERENCES tpvsneo (idtpv) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
</table>