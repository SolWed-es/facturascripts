<view>
    <columns>
        <group name="data" numcolumns="12" valign="bottom">
            <column name="code" display="none" order="0">
                <widget type="text" fieldname="idtpvpago"/>
            </column>
            <column name="pos-terminal" numcolumns="3" order="100">
                <widget type="select" fieldname="idtpv" required="true" onclick="EditTPVneo">
                    <values source="tpvsneo" fieldcode="idtpv" fieldtitle="name"/>
                </widget>
            </column>
            <column name="payment-method" titleurl="ListFormaPago" numcolumns="3" order="110">
                <widget type="select" fieldname="codpago" onclick="EditFormaPago" required="true">
                    <values/>
                </widget>
            </column>
            <column name="paid" order="120">
                <widget type="checkbox" fieldname="paid"/>
            </column>
        </group>
    </columns>
</view>