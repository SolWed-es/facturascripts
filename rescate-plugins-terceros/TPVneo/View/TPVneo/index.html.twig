{% extends "Master/MenuBgTemplate.html.twig" %}
{% import 'Macro/Forms.html.twig' as forms %}

{% block body %}
    {{ parent() }}
    <div class="container-fluid">
        <div class="form-row">
            <div class="col-lg-7 col-xl-8">
                <div id="titletpv" class="col-12 text-center mb-3">
                    <h3 class="mb-0">
                        {{ fsc.agente.nombre }}
                        {% if fsc.tpvAgents %}
                            <form action="{{ fsc.url() }}" method="post">
                                <input type="hidden" name="idtpv" value="{{ fsc.tpv.idtpv }}">
                                <button type="submit" name="action" value="agent-out"
                                        class="btn btn-outline-secondary ml-1">
                                    <i class="fas fa-users fa-fw"></i> {{ trans('change-agent') }}
                                </button>
                            </form>
                        {% endif %}
                    </h3>
                    <small class="text-secondary">{{ trans('pos-terminal') }}: {{ fsc.tpv.name }}</small>
                </div>
                <div class="form-row">
                    <div class="col-sm">
                        <form action="#" method="post" name="barcodeForm" onsubmit="return addBarcode()">
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                                </div>
                                <input type="text" name="barcode" class="form-control form-control-lg"
                                       placeholder="{{ trans('barcode') }}" autofocus>
                            </div>
                        </form>
                    </div>
                    <div class="col-sm">
                        <form method="post" name="productsForm" onsubmit="return searchProducts()">
                            <input type="hidden" name="action" value="find-products">
                            <input type="hidden" name="productlimit" value="{{ fsc.tpv.productlimit }}">
                            <input type="hidden" name="codalmacen" value="{{ fsc.tpv.codalmacen }}">
                            <input type="hidden" name="codfamilia" value="-1">
                            <input type="hidden" name="multireqtoken"
                                   value="{{ fsc.multiRequestProtection.newToken(fsc.user.logkey) }}"/>
                            <div class="input-group mb-3">
                                <div class="input-group-prepend">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                                <input type="text" name="query" class="form-control form-control-lg"
                                       placeholder="{{ trans('search') }}">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary" title="{{ trans('delete') }}"
                                            onclick="this.form.query.value=''; this.form.query.focus(); return searchProducts();">
                                        <i class="fas fa-backspace"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="col-12">
                        <div class="form-row" id="productList">
                            {{ fsc.renderProductList(fsc.tpv.codalmacen) | raw }}
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-xl-4">
                <div id="cart" class="card border-secondary shadow-sm">
                    <div class="card-header bg-secondary">
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div class="text-white font-weight-bold h4 m-0">
                                <i class="fas fa-shopping-basket"></i> {{ trans('cart') }}
                            </div>
                            <div class="btn-group dropdown">
                                <button class="btn btn-light dropdown-toggle" type="button" id="dropdownMenuButton"
                                        data-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cash-register"></i> {{ trans('box') }}
                                </button>
                                <div class="dropdown-menu dropdown-menu-right py-0"
                                     aria-labelledby="dropdownMenuButton">
                                    <form action="{{ fsc.url() }}" method="post">
                                        <input type="hidden" name="idtpv" value="">
                                        <input type="hidden" name="idcaja" value="">
                                        <input type="hidden" name="action" value="">
                                        <button type="submit" class="dropdown-item p-3" id="btnChangeTerminal">
                                            <i class="fas fa-exchange-alt fa-fw"></i> {{ trans('pos-terminals') }}
                                        </button>
                                    </form>
                                    <div class="dropdown-divider my-0"></div>
                                    {% if fsc.tpv.idprinter %}
                                        <button type="button" class="dropdown-item p-3" onclick="return openDrawer()">
                                            <i class="fas fa-inbox fa-fw"></i> {{ trans('open-drawer') }}
                                        </button>
                                    {% endif %}
                                    <button type="button" class="dropdown-item p-3" onclick="modalBoxMovement()">
                                        <i class="fas fa-coins fa-fw"></i> {{ trans('box-movement') }}
                                    </button>
                                    <form action="{{ fsc.url() }}" method="post">
                                        <input type="hidden" name="idtpv" value="{{ fsc.tpv.idtpv }}">
                                        <input type="hidden" name="idcaja" value="{{ fsc.caja.idcaja }}">
                                        <button type="submit" name="action" value="close-box-start"
                                                class="dropdown-item p-3 text-danger">
                                            <i class="fas fa-times fa-fw"></i> {{ trans('close-box') }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="input-group input-group-lg">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i id="iconCustomerSearch" class="fas fa-user"></i>
                                    <i id="iconCustomerClear"
                                       class="fas fa-times text-danger cursor-pointer d-none"></i>
                                </span>
                            </div>
                            <input type="text" name="query" class="form-control" id="customertpv"
                                   placeholder="{{ fsc.getNameClient() }}"/>
                            <div class="input-group-append">
                                <button class="btn btn-success btn-spin-action" type="button"
                                        onclick="return modalAddCustomer()" title="{{ trans('new-customer') }}">
                                    <i class="fas fa-user-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="saleDiv" class="card-body p-0 overflow-auto">
                        {{ fsc.renderSaleForm() | raw }}
                    </div>
                    {% if fsc.tpv.addemptyline or fsc.tpv.adddiscount %}
                        <div class="form-row p-3">
                            {% if fsc.tpv.addemptyline %}
                                <div class="col">
                                    <button class="btn btn-block btn-outline-success" onclick="modalNewLine()">
                                        <i class="fas fa-plus"></i>
                                        {{ trans('line') }}
                                    </button>
                                </div>
                            {% endif %}
                            {% if fsc.tpv.adddiscount %}
                                <div class="col">
                                    <div class="input-group">
                                        <input type="number" name="dtopor_global" value="0" min="0" max="100"
                                               class="form-control text-center">
                                        <div class="input-group-append">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="card-footer bg-secondary">
                        <div id="btnSaleFooter" class="form-row mb-2">
                            <div class="col">
                                <button type="button" onclick="collectMoney()"
                                        class="btn btn-block btn-success btn-lg btn-spin-action">
                                    {{ trans('collect-money') }}
                                    <span id="saleAmount">{{ fsc.getAmount() }}</span>
                                </button>
                            </div>
                            {% if fsc.tpv.preticket and fsc.tpv.idprinter %}
                                <div class="col-auto">
                                    <button onclick="return prePrintTicket()" title="{{ trans('print-preticket') }}"
                                            class="btn btn-block btn-light btn-lg btn-spin-action">
                                        <i class="fas fa-print"></i>
                                    </button>
                                </div>
                            {% endif %}
                            <div class="col-auto">
                                <button onclick="return clearCart()"
                                        class="btn btn-block btn-danger btn-lg btn-spin-action">
                                    {{ trans('delete') }}
                                </button>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="col-8">
                                <div class="btn-group btn-block" role="group">
                                    <button onclick="return modalPark()" class="btn btn-warning btn-lg btn-spin-action">
                                        {{ trans('park-ticket') }}
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-warning btn-lg btn-spin-action text-nowrap"
                                            id="btnPark" onclick="return modalListPark()">
                                        {{ trans('parked-tickets') }}
                                        <span class="badge badge-warning">{{ fsc.getParkCount() }}</span>
                                    </button>
                                </div>
                            </div>
                            <div class="col-4">
                                <button type="button" onclick="return modalTickets()"
                                        class="btn btn-block btn-primary btn-lg  btn-spin-action">
                                    {{ trans('tickets') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="floatCart" class="btn rounded-0 d-xl-none w-100 p-2 bg-success text-white text-center">
        <i class="fas fa-shopping-cart fa-fw"></i> {{ trans('view-cart') }}
    </div>

    <div class="modal fade" tabindex="-1" id="modalAddCustomer">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('new-customer')|capitalize }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>{{ trans('business-name') }}</label>
                        <input type="text" class="form-control" name="razonsocial" maxlength="100">
                    </div>
                    <div class="form-row">
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('type') }}</label>
                                <select name="personafisica" class="form-control">
                                    <option value="1">{{ trans('is-person') }}</option>
                                    <option value="0">{{ trans('company') }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('fiscal-id') }}</label>
                                {{ forms.simpleSelect('customer-fiscal', 'tipoidfiscal', settings('default', 'tipoidfiscal', 'NIF'),
                                    fsc.getSelectValues('idsfiscales', 'tipoidfiscal', 'tipoidfiscal', false)) }}
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('fiscal-number') }}</label>
                                <input type="text" class="form-control" name="cifnif" maxlength="30">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('address') }}</label>
                                <input type="text" class="form-control" name="address" maxlength="100">
                            </div>
                        </div>
                        <div class="col-sm-2">
                            <div class="form-group">
                                <label>{{ trans('post-office-box') }}</label>
                                <input type="text" class="form-control" name="apartado" maxlength="10">
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('zip-code') }}</label>
                                <input type="text" class="form-control" name="codpostal" maxlength="10">
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('city') }}</label>
                                <input type="text" class="form-control" name="ciudad" maxlength="100">
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('province') }}</label>
                                <input type="text" class="form-control" name="provincia" maxlength="100">
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('country') }}</label>
                                {{ forms.simpleSelect('customer-country', 'codpais', settings('default', 'codpais', 'ESP'),
                                    fsc.getSelectValues('paises', 'codpais', 'nombre', false)) }}
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('phone') }}</label>
                                <input type="text" class="form-control" name="telefono1" maxlength="30">
                            </div>
                        </div>
                        <div class="col-sm">
                            <div class="form-group">
                                <label>{{ trans('email') }}</label>
                                <input type="text" class="form-control" name="email" maxlength="100">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-lg"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="button" class="btn btn-success btn-lg btn-spin-action"
                            onclick="return saveAddCustomer()">{{ trans('save') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalReturn">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('returns') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div id="productsReturn"></div>
                <div id="optsReturn" class="modal-body">
                    <div class="row">
                        <div class="col-12 col-md-6 text-center">
                            <div>
                                <label>{{ trans('total-return') }}</label>
                            </div>
                            <div class="h1" id="totalReturn">
                                <span class="money"></span>
                                <span class="symbol ml-1">{{ fsc.getDivisa().simbolo }}</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 text-center">
                            <div>
                                <label>{{ trans('method-return') }}</label>
                            </div>
                            <div class="h1" id="methodReturn"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-lg"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="button" class="btn btn-success btn-lg btn-spin-action"
                            onclick="return saveReturn()">{{ trans('return') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalTickets">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('tickets') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <div class="row text-center">
                        <div class="col-2 col-sm">
                            <div class="font-weight-bolder">{{ trans('start-money') }}</div>
                            <div>{{ fsc.getFormatMoney(fsc.caja.dineroini) }}</div>
                        </div>
                        <div class="col-2 col-sm">
                            <div class="font-weight-bolder">{{ trans('cash-income') }}</div>
                            <div id="boxEstimated"></div>
                        </div>
                        <div class="col-2 col-sm">
                            <div class="font-weight-bolder">{{ trans('total-movements') }}</div>
                            <div id="boxTotalMovements"></div>
                        </div>
                        <div class="col-2 col-sm">
                            <div class="font-weight-bolder">{{ trans('total-in-box') }}</div>
                            <div id="boxTotal"></div>
                        </div>
                        <div class="col-2 col-sm">
                            <div class="font-weight-bolder">{{ trans('total-sales') }}</div>
                            <div id="boxTotalTickets"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-body text-center">
                    <div class="form-group border-top">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </div>
                            </div>
                            <input type="text" class="form-control text-center" id="searchTicket"
                                   placeholder="{{ trans('search-document', {'%doctype%': trans(fsc.tpv.doctype ~ '-min')|lower}) }}">
                        </div>
                    </div>
                </div>
                <div class="table-responsive" id="listTickets">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th class="text-nowrap">{{ trans('agent') }}</th>
                            <th class="text-nowrap">{{ trans('code') }}</th>
                            <th class="text-nowrap">{{ trans('number2') }}</th>
                            <th class="text-nowrap">{{ trans('customer') }}</th>
                            <th class="text-nowrap">{{ trans('payment-method') }}</th>
                            <th class="text-nowrap">{{ trans('observations') }}</th>
                            <th class="text-nowrap text-right">{{ trans('total') }}</th>
                            <th class="text-nowrap text-right">{{ trans('date') }}</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalPrintTicket">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('options-ticket') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <div id="optsPrint"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalCollectMoney">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('collect-money') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-0">
                    <div class="row bg-light text-center">
                        <div class="col-12 col-sm-6 py-3">
                            <div class="h1 mb-0" id="moneyTotal"></div>
                            <div class="small">{{ trans('total') }}</div>
                        </div>
                        <div class="col-12 col-sm-6 py-3">
                            <div class="h1 mb-0">
                                <span id="moneyChange"></span>
                                <span id="symbolChange"></span>
                            </div>
                            <div class="small">{{ trans('money-change') }}</div>
                        </div>
                    </div>
                    <div class="my-3 text-center">
                        <label class="font-weight-bold text-dark">{{ trans('payment-methods') }}</label>
                        <div id="paymentMethods">{{ fsc.getPaymentMethodsModalCollectMoneyHtml()|raw }}</div>
                    </div>
                    <div class="form-row">
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                {{ trans('number2') }}
                                <input id="number2" maxlength="50" class="form-control"/>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="form-group">
                                {{ trans('serie') }}
                                <select id="series" class="form-control">
                                    {% for serie in fsc.getSeries() %}
                                        {% set select = serie.codserie is same as(fsc.tpv.codserie) ? 'selected' : '' %}
                                        <option value="{{ serie.codserie }}" {{ select }}>{{ serie.descripcion }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                {{ trans('observations') }}
                                <textarea id="observations" class="form-control"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-lg"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="button" class="btn btn-success btn-lg btn-spin-action"
                            onclick="return saveCart()">{{ trans('save') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalPark">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('park-ticket') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    {% if fsc.prepagos %}
                        <div class="form-group">
                            <label>{{ trans('payment-method') }}</label>
                            <div class="input-group my-group">
                                <input type="number" min="0" id="amount" class="form-control" placeholder="0.00"/>
                                <select id="payments" class="form-control">
                                    {% for key, payment in fsc.getPaymentMethodsTpv() %}
                                        {% set select = payment.codpago is same as(fsc.tpv.codpago) ? 'selected' : '' %}
                                        <option value="{{ payment.codpago }}" {{ select }}>{{ payment.descripcion }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    {% endif %}
                    <textarea id="observations" class="form-control"
                              placeholder="{{ trans('observations') }}"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-lg"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="button" class="btn btn-warning btn-lg btn-spin-action"
                            onclick="return savePark()">{{ trans('park-ticket') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalListPark">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('cart-parking') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body"></div>
                <div class="table-responsive" id="listPark">
                    <table class="table table-hover mb-0">
                        <thead>
                        <tr>
                            <th>{{ trans('code') }}</th>
                            <th>{{ trans('customer') }}</th>
                            <th class="text-right">{{ trans('total') }}</th>
                            <th class="text-right">{{ trans('date') }}</th>
                            <th>{{ trans('observations') }}</th>
                            <th></th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deletePark">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center">
                    <i class="fas fa-trash-alt fa-3x"></i>
                    <h5 class="mt-3 mb-1">{{ trans('confirm-delete') }}</h5>
                    <p class="mb-0">{{ trans('are-you-sure') }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="return modalListPark()"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="button" class="btnDelete btn btn-danger"
                            onclick="">{{ trans('delete') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="modalBoxMovement">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('new-box-movement') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form method="post" name="boxMovementForm">
                        <div class="form-group">
                            {{ trans('quantity') }}
                            <div class="input-group mb-3">
                                <input type="number" min="0" class="form-control" name="qtyBoxMovement" autofocus
                                       required>
                                <div class="input-group-append">
                                    <span class="input-group-text"
                                          id="basic-addon2">{{ fsc.getDivisa().simbolo }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            {{ trans('type') }}
                            <div class="custom-control custom-radio">
                                <input type="radio" id="inBoxMovement" name="typeBoxMovement" value="IN"
                                       class="custom-control-input" required>
                                <label class="custom-control-label" for="inBoxMovement">{{ trans('money-in') }}</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" id="outBoxMovement" name="typeBoxMovement" value="OUT"
                                       class="custom-control-input" required checked>
                                <label class="custom-control-label"
                                       for="outBoxMovement">{{ trans('money-out') }}</label>
                            </div>
                        </div>
                        <div class="form-group">
                            {{ trans('motive') }}
                            <textarea class="form-control" maxlength="250" name="motiveBoxMovement"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="submit" class="btn btn-success btn-spin-action"
                            onclick="return boxMovement()">{{ trans('save') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="newLine">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ trans('new-line') }}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="{{ trans('close') }}">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        {{ trans('description') }}
                        <textarea class="form-control form-control-lg" rows="4" name="description"></textarea>
                    </div>
                    <div class="form-group">
                        {{ trans('tax') }}
                        <select name="codimpuesto" class="form-control form-control-lg">
                            {% for tax in fsc.getTaxes() %}
                                <option value="{{ tax.codimpuesto }}" {{ tax.codimpuesto is same as(settings('default', 'codimpuesto')) ? 'selected' : '' }}>{{ tax.descripcion }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-dismiss="modal">{{ trans('cancel') }}</button>
                    <button type="submit" class="btn btn-success btn-spin-action"
                            onclick="return newLine()">{{ trans('add') }}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-none" id="iframe">
        {% if fsc.tpv.idprinter %}
            <iframe src="http://localhost:8089"></iframe>
        {% endif %}
    </div>
{% endblock %}

