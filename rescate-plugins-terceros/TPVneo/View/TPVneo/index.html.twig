{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('node_modules/jquery-ui-dist/jquery-ui.min.js') }}"></script>
    <script>
        let codcliente = '';
        let codpark = '';
        let editLine = 0;
        let idDocReturn = '';
        let keyupInputName = null;
        let totalCart = 0;
        let totalReturn = 0;
        let waitCounter = 0;

        function addBarcode() {
            // obtenemos el barcode
            let barcode = document.forms['barcodeForm']['barcode'].value;

            if (barcode === '') {
                // obtenemos cuantos productos hay en el carrito
                let productCart = $('#linesCart .line').length;

                // si hay productos en el carrito, abrimos el modal de cobrar
                if (productCart > 0) {
                    collectMoney();
                }

                // en cualquier caso, no hacemos nada más
                return false;
            }

            document.forms['saleForm']['action'].value = 'add-barcode';
            document.forms['saleForm']['action-code'].value = barcode;
            let formData = new FormData(document.forms['saleForm']);

            document.forms['barcodeForm']['barcode'].value = '';

            return sendFormTpv(formData);
        }

        function addProduct(ref) {
            {% if fsc.tpv.sound %}
            let snd = new Audio("data:audio/wav;base64,");
            snd.play();
            {% endif %}

            document.forms['saleForm']['action'].value = 'add-product';
            document.forms['saleForm']['action-code'].value = ref;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function boxMovement() {
            const qty = $('input[name="qtyBoxMovement"]').val();
            const type = $('input[name="typeBoxMovement"]:checked').val();
            const motive = $('textarea[name="motiveBoxMovement"]').val();
            if (isNaN(qty) || type === undefined) {
                return false;
            }

            // la cantidad debe ser mayor que cero
            if (parseFloat(qty) <= 0) {
                setToast('{{ trans('box-movement-qty-error') }}', 'warning');
                return false;
            }

            let formData = new FormData();
            formData.append('action', 'box-movement');
            formData.append('quantity', qty);
            formData.append('type', type);
            formData.append('motive', motive);
            return sendFormTpv(formData);
        }

        function calculateReturn() {
            totalReturn = 0;
            $('#modalReturn #productsReturn tbody tr').each(function () {
                let input = $(this).find('input');

                if (parseFloat($(input).val()) > 0) {
                    totalReturn += parseFloat($(input).val()) * parseFloat($(this).attr('pvpunitario'));
                }
            });

            $('#modalReturn #totalReturn .money').html(totalReturn.toFixed(2));
        }

        function changeClient() {
            document.forms['saleForm']['action'].value = 'recalculate';
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function checkTotalPayments(input) {
            let total = 0;
            let cont = 0;
            let totalDefault = 0;
            let totalLine = 0;

            if (input.attr('max') !== '' && parseFloat(input.val()) > parseFloat(input.attr('max'))) {
                input.val('');
            }

            $("#modalCollectMoney #paymentMethods input").each(function () {
                if ($(this).val() !== '') {
                    let value = parseFloat($(this).val());

                    if ($(this).attr('max') === '') {
                        totalDefault = value;
                    } else {
                        totalLine += value;
                    }
                }
            });

            if (totalLine > 0 && parseFloat((totalDefault + totalLine).toFixed(2)) > parseFloat(totalCart)) {
                input.val('');
            }

            $("#modalCollectMoney #paymentMethods input").each(function () {
                if ($(this).val() !== '') {
                    total += parseFloat($(this).val());
                    cont++;
                }
            });

            let amount = $('#saleAmount').html().split(' ');
            let dec = amount[0].charAt(amount[0].length - 3);

            if (total === 0) {
                $('#modalCollectMoney #moneyChange').html((0).toFixed(2).replace('.', dec));
            } else {
                $('#modalCollectMoney #moneyChange').html((total - totalCart).toFixed(2).replace('.', dec));
            }

            $('#modalCollectMoney #symbolChange').html(amount[amount.length - 1]);
        }

        function clearCart() {
            codpark = '';
            document.forms['saleForm']['action'].value = 'clear-cart';
            document.forms['saleForm']['action-code'].value = '';
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function collectMoney() {
            if ($('#linesCart .line').length <= 0) {
                return;
            }

            $('#modalCollectMoney #moneyTotal').html($('#saleAmount').html());
            $('#modalCollectMoney #moneyChange').html('');
            $('#modalCollectMoney #symbolChange').html('');

            $("#modalCollectMoney #paymentMethods input").each(function () {
                if ($(this).attr('codpago') !== '{{ fsc.tpv.codpago }}') {
                    $(this).attr('max', totalCart);
                }
                checkTotalPayments($(this));
            });

            $('#modalCollectMoney').modal('show');
            $('#modalCollectMoney').on('shown.bs.modal', function () {
                $('#modalCollectMoney #paymentMethods input:first').focus();
            });
        }

        function collectMoneyClear() {
            $('#modalCollectMoney textarea, #modalCollectMoney input').val('');
        }

        function deleteDocPark(codpark) {
            let formData = new FormData();
            formData.append('action', 'delete-park');
            formData.append('codpark', codpark);
            return sendFormTpv(formData);
        }

        function heightCart() {
            let windowh = $(window).height();
            let nav = $('nav:first').outerHeight();
            let space = $('nav:first').next().outerHeight();
            let titletpv = $('#titletpv').outerHeight();
            $('#cart').css('height', windowh - (nav + space + titletpv + 25) + 'px');
        }

        function heightProductCard() {
            let height = 0;
            $('#productList .card').each(function () {
                if ($(this).height() > height) {
                    height = $(this).height();
                }
            });
            $('#productList .card').height(height);
        }

        function lineDiscount(num, dto) {
            document.forms['saleForm']['action'].value = 'recalculate';
            document.forms['saleForm']['action-code'].value = '';
            document.forms['saleForm']['dtopor_' + num].value = dto;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function lineQuantity(num, qty) {
            document.forms['saleForm']['action'].value = 'recalculate';
            document.forms['saleForm']['action-code'].value = '';
            document.forms['saleForm']['cantidad_' + num].value = qty;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function linePrice(num, price) {
            document.forms['saleForm']['action'].value = 'recalculate';
            document.forms['saleForm']['action-code'].value = '';
            document.forms['saleForm']['new_precio_' + num].value = price;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function changeDescriptionPrompt(num) {
            let desc = prompt('{{ trans('description') }}');
            if (desc.trim() === '') {
                return false;
            }

            $('#linesCart .line' + num + ' .desc').html(desc);
            $('#linesCart .line' + num + ' input[name="descripcion_' + num + '"]').val(desc);
        }

        function changeDtoPrompt(num) {
            const dto = parseFloat(prompt('{{ trans('discount') }}').replace(',', '.')) || 0;
            return lineDiscount(num, dto);
        }

        function changePricePrompt(num) {
            const price = parseFloat(prompt('{{ trans('price') }}').replace(',', '.')) || 0;
            return linePrice(num, price);
        }

        function changeQtyPrompt(num) {
            const qty = parseFloat(prompt('{{ trans('quantity') }}').replace(',', '.')) || 0;
            return lineQuantity(num, qty);
        }

        function loadPark(codpark) {
            document.forms['saleForm']['action'].value = 'load-park';
            document.forms['saleForm']['codpark'].value = codpark;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function modalAddCustomer() {
            $('#modalAddCustomer').modal('show');
            $('#modalAddCustomer').on('shown.bs.modal', function () {
                $('#modalAddCustomer input:first').focus();
            });
        }

        function modalBoxMovement() {
            $('#modalBoxMovement').modal('show');
            $('#modalBoxMovement').on('show.bs.modal', function () {
                // limpiamos los campos
                $('form[name="boxMovementForm"]').get(0).reset();
            });
        }

        function modalDeletePark(codpark) {
            $('#modalListPark').modal('hide');
            $('#deletePark .btnDelete').attr('onclick', "return deleteDocPark(" + codpark + ")");
            $('#deletePark').modal('show');
        }

        function modalNewLine() {
            $('#newLine').modal('show');
            $('#newLine').on('shown.bs.modal', function () {
                $('#newLine textarea[name="description"]').focus();
            });
        }

        function modalTickets() {
            return searchTickets();
        }

        function modalListPark() {
            $('#listPark tbody').html('');
            let formData = new FormData();
            formData.append('action', 'modal-list-park');
            return sendFormTpv(formData);
        }

        function modalPark() {
            if (totalCart <= 0) {
                return false;
            }

            $('#modalPark').modal('show');
            $('#modalPark input, #modalPark textarea').val('');
            $('#modalPark').on('shown.bs.modal', function () {
                $('#modalPark input:first').focus();
            });
        }

        function modalPrintTicket(idDoc, pay = false) {
            $('#modalTickets').modal('hide');
            $('#modalPrintTicket').modal('show');
            $('#modalPrintTicket #optsPrint').html('');
            let formData = new FormData();
            formData.append('action', 'load-doc-print');
            formData.append('idDoc', idDoc);

            if (pay) {
                formData.append('pay', true);
            }

            return sendFormTpv(formData);
        }

        function modalReturn(idDoc) {
            $('#modalTickets').modal('hide');
            $('#modalReturn #optsReturn').hide();
            $('#modalReturn #productsReturn').html('');
            $('#modalReturn').modal('show');
            let formData = new FormData();
            formData.append('action', 'load-doc-return');
            formData.append('idDoc', idDoc);
            return sendFormTpv(formData);
        }

        function newLine() {
            let desc = $('#newLine textarea[name="description"]').val();
            let tax = $('#newLine select[name="codimpuesto"] option:selected').val();

            if (desc.trim() === '' || tax === '') {
                return false;
            }

            document.forms['saleForm']['action'].value = 'new-line';
            document.forms['saleForm']['new-desc'].value = desc;
            document.forms['saleForm']['new-tax'].value = tax;
            let formData = new FormData(document.forms['saleForm']);
            if (false === sendFormTpv(formData)) {
                return false;
            }

            $('#linesCart .line:last .desc').html(desc);
            $('#linesCart .line:last input[name="desc_*"]').val(desc);
            document.forms['saleForm']['action'].value = '';
            return true;
        }

        function openDrawer() {
            let formData = new FormData();
            formData.append('action', 'open-drawer');
            return sendFormTpv(formData);
        }

        function prePrintTicket() {
            document.forms['saleForm']['action'].value = 'pre-print-ticket';
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function printTicket(idDoc) {
            let formData = new FormData();
            formData.append('action', 'print-ticket');
            formData.append('idDoc', idDoc);
            formData.append('ticketformat', $('#modalPrintTicket #ticketformat option:selected').val());
            formData.append('ticket_number', $('#modalPrintTicket input[name="ticket_number"]').val());
            return sendFormTpv(formData);
        }

        function rmLine(num) {
            document.forms['saleForm']['action'].value = 'rm-line';
            document.forms['saleForm']['action-code'].value = num;
            let formData = new FormData(document.forms['saleForm']);
            return sendFormTpv(formData);
        }

        function saveAddCustomer() {
            let formData = new FormData();
            formData.append('action', 'add-customer');
            formData.append('empresa', $('#modalAddCustomer input[name="razonsocial"]').val());
            formData.append('cifnif', $('#modalAddCustomer input[name="cifnif"]').val());
            formData.append('direccion', $('#modalAddCustomer input[name="address"]').val());
            formData.append('apartado', $('#modalAddCustomer input[name="apartado"]').val());
            formData.append('codpostal', $('#modalAddCustomer input[name="codpostal"]').val());
            formData.append('ciudad', $('#modalAddCustomer input[name="ciudad"]').val());
            formData.append('provincia', $('#modalAddCustomer input[name="provincia"]').val());
            formData.append('telefono1', $('#modalAddCustomer input[name="telefono1"]').val());
            formData.append('email', $('#modalAddCustomer input[name="email"]').val());
            formData.append('personafisica', $('#modalAddCustomer select[name="personafisica"] option:selected').val());
            formData.append('tipoidfiscal', $('#modalAddCustomer select[name="tipoidfiscal"] option:selected').val());
            formData.append('codpais', $('#modalAddCustomer select[name="codpais"] option:selected').val());

            // limpiamos los campos
            $('#modalAddCustomer input').val('');
            $('#modalAddCustomer select[name="personafisica"] option[value="1"]').prop('selected', true);
            $('#modalAddCustomer select[name="tipoidfiscal"] option[value="{{ settings('default', 'tipoidfiscal') }}"]').prop('selected', true);
            $('#modalAddCustomer select[name="codpais"] option[value="{{ settings('default', 'codpais') }}"]').prop('selected', true);

            return sendFormTpv(formData);
        }

        function saveCart() {
            document.forms['saleForm']['action'].value = 'save-cart';
            document.forms['saleForm']['action-code'].value = '';

            let formData = new FormData(document.forms['saleForm']);
            formData.append('observations', $('#modalCollectMoney #observations').val());
            formData.append('numero2', $('#modalCollectMoney #number2').val());
            formData.append('codserie', $('#modalCollectMoney select#series option:selected').val());
            let moneyReceived = 0;
            let formasPagos = 0;

            $("#modalCollectMoney #paymentMethods input").each(function () {
                let money = parseFloat($(this).val());
                if (money > 0) {
                    formasPagos++;
                    moneyReceived += money;
                    formData.append($(this).attr('codpago'), money);
                }
            });

            let decimals = totalCart.split('.');
            if (moneyReceived.toFixed(decimals.length) >= parseFloat(totalCart)) {
                formData.append('formasPagos', formasPagos);
                if (codpark != '') {
                    document.forms['saleForm']['codpark'].value = codpark;
                    formData.append('codpark', codpark);
                }
                return sendFormTpv(formData);
            }

            return false;
        }

        function savePark() {
            if (totalCart <= 0) {
                return false;
            }

            document.forms['saleForm']['action'].value = 'save-park';
            document.forms['saleForm']['action-code'].value = '';
            if (codpark !== '') {
                document.forms['saleForm']['codpark'].value = codpark;
            }
            let formData = new FormData(document.forms['saleForm']);
            formData.append('advance-payment-amount', $('#modalPark #amount').val());
            formData.append('advance-payment', $('#modalPark #payments option:selected').val());
            formData.append('observations', $('#modalPark #observations').val());
            return sendFormTpv(formData);
        }

        function saveReturn() {
            let formData = new FormData();
            let cont = 0;
            $('#modalReturn #productsReturn tbody tr').each(function () {
                let val = parseFloat($(this).find('input').val());

                if (val > 0) {
                    formData.append('referencia_' + cont, $(this).attr('referencia'));
                    formData.append('idlinea_' + cont, $(this).attr('idlinea'));
                    formData.append('cantidad_' + cont, val);
                    cont++;
                }
            });
            formData.append('action', 'save-return');
            formData.append('lines', cont);
            formData.append('idDocReturn', idDocReturn);
            return sendFormTpv(formData);
        }

        function searchProducts() {
            document.forms['productsForm']['productlimit'].value = 0;
            let formData = new FormData(document.forms['productsForm']);
            return sendFormTpv(formData);
        }

        function searchTickets(codigo = '') {
            $('#listTickets tbody').html('<i class="fas fa-spinner fa-spin"></i>');
            let formData = new FormData();
            formData.append('action', 'modal-tickets');
            formData.append('codigo', codigo);
            return sendFormTpv(formData);
        }

        function sendDoc(idDoc) {
            let formData = new FormData();
            formData.append('action', 'send-doc');
            formData.append('idDoc', idDoc);
            formData.append('email', $('#modalPrintTicket #emailInput').val());
            formData.append('mailbox', $('#modalPrintTicket select[name="mailbox"] option:selected').val());
            return sendFormTpv(formData);
        }

        function sendFormTpv(formData) {
            if (editLine > 1) {
                editLine--;
                return false;
            }

            editLine = 0;
            animateSpinner('add');

            formData.append('linesCart', $('#linesCart .line').length);
            formData.append('codcliente', codcliente);
            formData.append('idtpv', {{ fsc.tpv.idtpv }});
            formData.append('idcaja', {{ fsc.caja.idcaja }});
            formData.append('dtopor_global', $('input[name="dtopor_global"]').val());
            formData.append('ajax', true);

            console.log(Object.fromEntries(formData));

            fetch('{{ fsc.url() }}', {
                method: 'POST',
                body: formData
            }).then(function (response) {
                if (response.ok) {
                    animateSpinner('remove', true);
                    return response.json();
                }

                animateSpinner('remove', false);
                return Promise.reject(response);
            }).then(function (data) {
                console.log(data);

                if (data.refresh) {
                    $('#btnChangeTerminal').click();
                }

                if (['add-product', 'new-line', 'add-barcode'].includes(formData.get('action'))) {
                    $('.modalProductInfo').modal('hide');
                    $("#saleDiv").animate({scrollTop: $('#saleDiv').prop("scrollHeight")}, 1000);
                }

                if (formData.get('action') === 'delete-park') {
                    modalListPark();
                    $('#deletePark').modal('hide');
                    $('#btnPark span.badge').html(data.totalParks);

                    if (parseInt(formData.get('codpark')) === parseInt(codpark)) {
                        codpark = '';
                        document.forms['saleForm']['codpark'].value = codpark;
                    }
                }

                if (formData.get('action') === 'load-park') {
                    $('#modalListPark').modal('hide');

                    collectMoneyClear();

                    // cargamos el descuento global
                    $('input[name="dtopor_global"]').val(data['dtopor_global']);

                    // cargamos las observaciones
                    $('#modalCollectMoney #observations').val(data['observations']);

                    // cargamos los pagos anticipados
                    $.each(data['advance-payments'], function (key, value) {
                        $('#modalCollectMoney #paymentMethods input[codpago="' + value.codpago + '"]').val(value.amount);
                    });

                    // cargamos el cliente si es diferente al del tpv
                    if (data['customer'] && data['customer']['codcliente'] !== '{{ fsc.tpv.codcliente }}') {
                        $('#customertpv').val(data['customer']['nombre']);
                        codcliente = data['customer']['codcliente'];
                        $('#saleDiv input[name="codcliente"]').val(codcliente);
                        $('#iconCustomerSearch').addClass('d-none');
                        $('#iconCustomerClear').removeClass('d-none');
                        setSerie(data['customer']['codserie']);
                    } else {
                        codcliente = '';
                        $('#customertpv').val('');
                        $('#saleDiv input[name="codcliente"]').val(codcliente);
                        $('#iconCustomerSearch').removeClass('d-none');
                        $('#iconCustomerClear').addClass('d-none');
                        setSerie('{{ fsc.tpv.codserie }}');
                    }
                }

                if (formData.get('action') === 'modal-list-park') {
                    $('#modalListPark').modal('show');

                    if (data.totalParks > 0) {
                        $('#btnPark span.badge').html(data.totalParks);
                    } else {
                        $('#btnPark span.badge').html('');
                    }
                }

                if (formData.get('action') === 'save-park') {
                    $('#modalPark').modal('hide');
                }

                if (formData.get('action') === 'modal-tickets') {
                    $('#modalTickets').modal('show');
                    $('#modalTickets #boxEstimated').html(data.boxEstimated);
                    $('#modalTickets #boxTotal').html(data.boxTotal);
                    $('#modalTickets #boxTotalTickets').html(data.boxTotalTickets);
                    $('#modalTickets #boxTotalMovements').html(data.boxTotalMovements);
                }

                if (formData.get('action') === 'print-ticket') {
                    $('#modalPrintTicket').modal('hide');
                    $('form[name="barcodeForm"] input[name="barcode"]').focus();
                }

                if (['open-drawer', 'print-ticket', 'pre-print-ticket'].includes(formData.get('action'))) {
                    setIframe();
                }

                if (data.totalCart) {
                    totalCart = data.totalCart;

                    if (data.totalCart > 0) {
                        $('#saleAmount').popover('show');
                        setInterval(function () {
                            $('#saleAmount').popover('hide');
                        }, 2000);
                        $('#btnSaleFooter').show();
                    } else if (formData.get('action') !== 'recalculate' && formData.get('action') !== 'load-park') {
                        $('#btnSaleFooter').hide();
                        $('#products-tab').click();
                    }
                }

                if (data.amount && data.amount !== '' && data.amount !== document.getElementById("saleAmount").innerHTML) {
                    document.getElementById("saleAmount").innerHTML = data.amount;
                }

                if (data.cart && data.cart !== '') {
                    document.getElementById("saleDiv").innerHTML = data.cart;
                } else if (data.cartMap && !data.cartMap.length) {
                    $.each(data.cartMap, function (index, value) {
                        $('#saleDiv').find('#' + index).html(value);
                    });
                }

                if (formData.get('action') === 'new-line') {
                    $('#linesCart .line:last input.precio').val('').focus();

                    // ocultamos el modal de nueva línea y restauramos
                    $('#newLine').modal('hide');
                    $('#newLine textarea').val('');
                    $('#newLine select[name="codimpuesto"] option[value="{{ settings('default', 'codimpuesto') }}"]').prop('selected', true);
                }

                if (data.products && data.products !== '') {
                    document.getElementById("productList").innerHTML = data.products;
                    heightProductCard();
                }

                if (data.savecart) {
                    $('#modalCollectMoney').modal('hide');
                    collectMoneyClear();
                    modalPrintTicket(data.document.code, true);
                    $('#btnPark span.badge').html(data.totalParks);
                }

                if (data.savereturn) {
                    $('#modalReturn').modal('hide');
                    modalPrintTicket(data.document.code);
                }

                if (data.savepark || data.savecart || data.clearcart) {
                    // si el cliente no es él por defecto, lo restablecemos
                    if (codcliente !== '{{ fsc.tpv.codcliente }}') {
                        $('#iconCustomerClear').click();
                    }
                }

                if (data.savepark || data.savecart) {
                    clearCart();
                }

                if (data.clearcart) {
                    searchProducts();
                    $('#btnSaleFooter').hide();
                    $('#products-tab').click();
                    $('input[name="dtopor_global"]').val(0);
                }

                if (data.savecart && codpark !== '' || $('#linesCart .line').length === 0 && codpark !== '') {
                    codpark = '';
                }

                if (data.savepark) {
                    $('#btnPark button').popover('show');
                    setInterval(function () {
                        $('#btnPark button').popover('hide');
                    }, 2000);
                    $('#btnPark span.badge').html(data.totalParks);
                }

                if (data.codpark && data.codpark !== '') {
                    codpark = data.codpark;
                }

                if (data.presupuestos && data.presupuestos !== '') {
                    $('#listPark tbody').html(data.presupuestos);
                }

                if (data.tickets && data.tickets !== '') {
                    $('#listTickets tbody').html(data.tickets);
                }

                if (data.docprint && data.docprint !== '') {
                    $('#modalPrintTicket #optsPrint').html(data.docprint);
                }

                if (data.docreturn && data.docreturn !== '') {
                    $('#modalReturn #productsReturn').html(data.docreturn);
                    $('#modalReturn #methodReturn').html(data.methodreturn);

                    totalReturn = 0;
                    idDocReturn = data.idDoc;
                    $('#modalReturn #totalReturn .money').html(totalReturn.toFixed(2));
                    $('#modalReturn #optsReturn').show();
                }

                if (formData.get('action') === 'add-customer' && data.customer) {
                    codcliente = data.customer.codcliente;
                    $('#customertpv').val(data.customer.nombre);
                    $('#saleDiv input[name="codcliente"]').val(codcliente);
                    $('#iconCustomerSearch').addClass('d-none');
                    $('#iconCustomerClear').removeClass('d-none');
                    changeClient();
                    $('#modalAddCustomer').modal('hide');

                    // establecemos la serie del tpv
                    setSerie('{{ fsc.tpv.codserie }}');
                }

                if (data.boxMovement) {
                    $('#modalBoxMovement').modal('hide');
                }

                document.forms['productsForm']['productlimit'].value = {{ fsc.tpv.productlimit }};

                // si no hay foco, establecemos el foco si tenemos el name del input donde se estaba escribiendo
                if (formData.get('action') === 'recalculate-line' && document.activeElement.name === undefined && keyupInputName !== null) {
                    let focusInput = $('input[name="' + keyupInputName + '"]');
                    let focusLength = focusInput.val().length;
                    let focusType = focusInput[0].type;
                    // para establecer el cursor al final de input el type debe ser text
                    if (focusType !== 'text') {
                        focusInput[0].type = 'text';
                    }
                    focusInput.focus();
                    focusInput[0].setSelectionRange(focusLength, focusLength);
                    focusInput[0].type = focusType;
                    keyupInputName = null;
                }

                // si hay líneas, establecemos el orden de las líneas
                if ($('#linesCart .line').length > 0) {
                    let orderInputs = $("#linesCart .line input[name^='orden_']");
                    let count = orderInputs.length * 10;
                    orderInputs.each(function (index) {
                        $(this).val(count - (index * 10));
                    });
                }

                // si hay mensajes de error
                if (data.messages) {
                    data.messages.forEach(function (msg) {
                        if (msg.level === 'danger') {
                            setToast(msg.message, msg.level, '', 0);
                        } else {
                            setToast(msg.message, msg.level);
                        }
                    });
                }
            }).catch(function (error) {
                alert('error');
                console.warn(error);
            });

            return false;
        }

        function setIframe() {
            $('#iframe').html('<iframe src="http://localhost:8089"></iframe>');
        }

        function setSerie(codserie) {
            $('select#series option').each(function () {
                if ($(this).val() === codserie) {
                    $(this).prop('selected', true);
                }
            });
        }

        function selectAllReturn() {
            $('#modalReturn #productsReturn tbody tr input').each(function () {
                $(this).val($(this).attr('max'));
            });

            calculateReturn();
        }

        function selectNoneReturn() {
            $('#modalReturn #productsReturn tbody tr input').each(function () {
                $(this).val($(this).attr('min'));
            });

            calculateReturn();
        }

        function showFamily(codfamilia) {
            document.forms['productsForm']['codfamilia'].value = codfamilia;
            document.forms['productsForm']['query'].value = '';
            let formData = new FormData(document.forms['productsForm']);
            return sendFormTpv(formData);
        }

        $(document).on('keyup', '#modalCollectMoney #paymentMethods input', function () {
            checkTotalPayments($(this));
        });

        $(document).on('click', '#modalCollectMoney #paymentMethods .setMaxPayment', function () {
            let input = $(this).parent().parent().find('input');

            // recorremos todas las formas de pago sumando cada importe
            let total = 0;
            $("#modalCollectMoney #paymentMethods input").each(function () {
                if ($(this).val() !== '') {
                    total += parseFloat($(this).val());
                }
            });

            // obtenemos la diferencia entre el total y el importe del carrito
            let diff = parseFloat(totalCart) - total;

            // si la diferencia es menor o igual a 0, no hacemos nada
            if (diff <= 0) {
                return;
            }

            // si la diferencia es mayor a 0, establecemos el importe de la forma de pago
            $(input).val(diff.toFixed(2));

            checkTotalPayments(input);
        });

        $(document).on('keyup change', 'input[name="dtopor_global"]', async function () {
            // usamos un contador y un temporizador para solamente procesar la última llamada
            waitCounter++;
            let waitNum = waitCounter;
            await new Promise(r => setTimeout(r, 300));
            if (waitNum < waitCounter) {
                return;
            }

            // obtenemos el name del input si cumple la condición de pulsado
            keyupInputName = $(this).attr('name');

            editLine++;
            document.forms['saleForm']['action'].value = 'recalculate-line';
            let formData = new FormData(document.forms['saleForm']);
            sendFormTpv(formData);
        });

        $(document).on('keyup change', '#modalReturn #productsReturn tbody tr input', function () {
            let max = parseFloat($(this).attr('max'));
            let val = parseFloat($(this).val());

            if (val > max) {
                $(this).val(max);
            }

            calculateReturn();
        });

        $(document).on('keyup change', '#searchTicket', function () {
            let val = $(this).val();
            if (val.length >= 3) {
                return searchTickets(val);
            } else if (val === '') {
                return searchTickets();
            }
        });

        // al pulsar enter en cualquier input del modal de cobrar
        // hacer clic en el botón de guardar
        $(document).on('keypress', '#modalCollectMoney #paymentMethods input', function (e) {
            var code = (e.keyCode ? e.keyCode : e.which);
            if (code === 13) {
                $('#modalCollectMoney .modal-footer .btn-success').click();
            }
        });

        // al poner el foco en el campo barcode
        $(document).on('focus', 'input[name="barcode"]', function () {
            // si el campo de búsqueda está vacío, no hacemos nada
            if ($('input[name="query"]').val() === '') {
                return;
            }

            // vaciamos el campo de búsqueda
            $('input[name="query"]').val('');

            // enviamos el formulario
            searchProducts();
        });

        $(document).ready(function () {
            $('#btnSaleFooter').hide();
            let changeAgentTime = parseInt({{ fsc.tpv.closeagent }});

            {% if fsc.tpv.idprinter %}
            // creamos un contador para ejecutar cada minuto el iframe de la impresora
            setInterval(function () {
                setIframe();
            }, 60000);
            {% endif %}

            if (changeAgentTime > 0) {
                let intervalCloseAgent;

                function startCounter() {
                    intervalCloseAgent = setInterval(function () {
                        window.location.href = '{{ fsc.url() }}?action=agent-out';
                    }, changeAgentTime * 60000);
                }

                startCounter();

                function stopCounter() {
                    clearInterval(intervalCloseAgent);
                    startCounter();
                }

                $(document).mousemove(function (e) {
                    stopCounter();
                });

                $(document).click(function (e) {
                    stopCounter();
                });

                $(document).keypress(function (e) {
                    stopCounter();
                });
            }

            function widthCart() {
                let parentDiv = $('#cart').parent().width();
                $('#cart').css({'width': '100%', 'max-width': parentDiv + 'px'});
            }

            widthCart();

            let observerCart = new IntersectionObserver(function (entries) {
                if (entries[0]['isIntersecting'] === true) {
                    if (entries[0].intersectionRatio >= 0.5) {
                        $('#floatCart').hide('slow');
                    } else {
                        $('#floatCart').show('slow');
                    }
                } else {
                    $('#floatCart').show('slow');
                }
            }, {threshold: [0, 0.5, 1]});
            observerCart.observe(document.querySelector("#cart"));

            $('#floatCart').click(function () {
                $('html,body').animate({
                    scrollTop: $('#cart').offset().top
                }, 'slow');
            });

            $('#saleAmount').popover({
                placement: 'bottom',
                trigger: 'manual',
                content: '{{ trans('updated-cart') }}'
            });

            $('#btnPark button').popover({
                placement: 'bottom',
                trigger: 'hover manual',
                content: '{{ trans('cart-parking') }}'
            });

            $('#saleAmount').click(function () {
                $('#saleAmount').popover('hide');
            });

            $(document).on('click', '#iconCustomerClear', function () {
                if ($("#customertpv").val() != '') {
                    $('#iconCustomerSearch').removeClass('d-none');
                    $('#iconCustomerClear').addClass('d-none');
                    $("#customertpv").val('');
                    codcliente = '';
                    changeClient();

                    // establecemos la serie por defecto del terminal
                    setSerie('{{ fsc.tpv.codserie }}');
                }
            });

            $("#customertpv").autocomplete({
                source: function (request, response) {
                    let formData = {};
                    formData["action"] = "autocomplete-customer";
                    formData["query"] = $("#customertpv").val();
                    formData["idcaja"] = '{{ fsc.caja.idcaja }}';
                    formData["idtpv"] = '{{ fsc.tpv.idtpv }}';
                    formData["ajax"] = true;

                    $.ajax({
                        method: "POST",
                        url: "{{ fsc.url() }}",
                        data: formData,
                        dataType: "json",
                        success: function (results) {
                            if (results.refresh) {
                                $('#btnChangeTerminal').click();
                            }

                            response(results);
                        },
                        error: function (msg) {
                            alert(msg.status + " " + msg.responseText);
                        }
                    });
                },
                select: function (event, ui) {
                    if (ui.item.key !== null) {
                        codcliente = ui.item.key;
                        $('#iconCustomerSearch').addClass('d-none');
                        $('#iconCustomerClear').removeClass('d-none');
                        changeClient();

                        // establecemos la serie del cliente
                        if (ui.item.serie !== null) {
                            setSerie(ui.item.serie);
                        }
                    }
                }
            });

            heightProductCard();
            heightCart();
        });
    </script>
{% endblock %}