{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
    {{ parent() }}
    {% set divisa = fsc.getDivisa() %}
    <div class="bg-light pt-3 pb-5">
        <div class="container">
            <div class="row">
                <div class="col">
                    <h1 class="h2">
                        <i class="fas fa-cash-register"></i> {{ trans('close-box') }}
                        ({{ divisa.simbolo }})
                    </h1>
                    <small class="text-secondary">{{ trans('pos-terminal') }}: {{ fsc.tpv.name }}</small>
                </div>
            </div>
        </div>
    </div>
    <div class="container" style="margin-top: -40px;">
        <div class="row">
            <div class="col-sm">
                <div class="card shadow mb-4">
                    <form action="{{ fsc.url() }}" method="post" id="saveForm">
                        <div class="card-body">
                            {{ formToken() }}
                            <input type="hidden" name="action" value="close-box">
                            <input type="hidden" name="idtpv" value="{{ fsc.tpv.idtpv }}">
                            <input type="hidden" name="idcaja" value="{{ fsc.caja.idcaja }}"/>
                            <div class="form-row">
                                {% for coin in fsc.getCoinTypes() %}
                                    <div class="col-sm-4 pb-3">
                                        {{ (coin.name < 1) ? coin.name | number_format(2) : coin.name }}
                                        {{ divisa.simbolo }}
                                        <input type="number" name="{{ coin.name|replace({'.': '_'}) }}" value="0"
                                               min="0" class="form-control" required=""/>
                                    </div>
                                {% else %}
                                    <div class="col pb-4">
                                        <div class="alert alert-warning">{{ trans('currency-setup-incomplete') }}</div>
                                        <a href="{{ fsc.getDivisa().url() }}" class="btn btn-warning">
                                            {{ trans('configure') }}</a>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="form-group">
                                {{ trans('observations') }}
                                <textarea name="observaciones" class="form-control"></textarea>
                            </div>
                            <div class="form-row">
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('start-money') }}</div>
                                    <div>{{ fsc.getFormatMoney(fsc.caja.dineroini) }}</div>
                                </div>
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('cash-income') }}</div>
                                    <div>{{ fsc.getFormatMoney(fsc.caja.ingresos) }}</div>
                                </div>
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('total-movements') }}</div>
                                    <div>{{ fsc.getFormatMoney(fsc.caja.totalmovi) }}</div>
                                </div>
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('total-in-box') }}</div>
                                    <div>{{ fsc.getFormatMoney(fsc.caja.totalcaja) }}</div>
                                </div>
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('box-counting') }}</div>
                                    <span id="boxCounting">0.00</span> {{ divisa.simbolo }}
                                </div>
                                <div class="col-sm text-center">
                                    <div class="font-weight-bolder">{{ trans('total-sales') }}</div>
                                    <div>{{ fsc.getFormatMoney(fsc.caja.totaltickets) }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="form-row">
                                <div class="col">
                                    <button type="button" onclick="cancelForm()"
                                            class="btn btn-secondary btn-spin-action">
                                        {{ trans('cancel') }}
                                    </button>
                                </div>
                                <div class="col text-right">
                                    <button type="button" onclick="saveForm()" class="btn btn-primary btn-spin-action">
                                        {{ trans('save') }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                {% set totalPayments = fsc.caja.getPaymentBreakdown() %}
                {% if totalPayments | length > 0 %}
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <div class="form-row">
                                {% for payment in totalPayments %}
                                    <div class="col-sm text-center">
                                        <div class="font-weight-bold h5">{{ money(payment.total, fsc.tpv.coddivisa) }}</div>
                                        <div>{{ payment.descripcion }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="text-center">
                    <a href="{{ fsc.url() }}" class="btn btn-block btn-secondary">
                        <i class="fas fa-list mr-1"></i> {{ trans('pos-terminals') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
    <iframe class="d-none" src="http://localhost:8089"></iframe>
    <script src="{{ asset('Dinamic/Assets/JS/boxCounting.js') }}"></script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        function cancelForm() {
            animateSpinner('add');

            // creamos un formulario post
            var form = document.createElement('form');
            form.setAttribute('method', 'post');
            form.setAttribute('action', '{{ fsc.url() }}');

            // añadimos el input con el action
            var input = document.createElement('input');
            input.setAttribute('type', 'hidden');
            input.setAttribute('name', 'action');
            input.setAttribute('value', 'select-tpv');

            // añadimos el idtpv
            var input2 = document.createElement('input');
            input2.setAttribute('type', 'hidden');
            input2.setAttribute('name', 'idtpv');
            input2.setAttribute('value', '{{ fsc.tpv.idtpv }}');

            // añadimos el idcaja
            var input3 = document.createElement('input');
            input3.setAttribute('type', 'hidden');
            input3.setAttribute('name', 'idcaja');
            input3.setAttribute('value', '{{ fsc.caja.idcaja }}');

            // enviamos el formulario
            form.appendChild(input);
            form.appendChild(input2);
            form.appendChild(input3);
            document.body.appendChild(form);
            form.submit();
        }

        function saveForm() {
            animateSpinner('add');
            document.getElementById('saveForm').submit();
        }
    </script>
{% endblock %}