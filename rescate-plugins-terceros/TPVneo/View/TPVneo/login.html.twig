{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
    {{ parent() }}
    <div class="bg-light pt-5 pb-5">
    </div>
    <div class="container" style="margin-top: -40px;">
        {% set agents = fsc.agente.all([], [], 0, 0) %}
        <div class="row d-flex justify-content-center">
            {% if agents|length > 0 %}
                <div class="col-sm-4">
                    <form action="{{ fsc.url() }}" method="post" autocomplete="off" id="loginForm">
                        {{ formToken() }}
                        <input type="hidden" name="action" value="agent-auth">
                        <input type="hidden" name="idtpv" value="{{ fsc.tpv.idtpv }}">
                        <div class="card shadow mb-4">
                            <div class="card-body">
                                <h1 class="h3">
                                    <i class="fas fa-user-tie fa-fw"></i> {{ trans('agent') }}
                                </h1>
                                <div class="form-group">
                                    <select name="codagente" class="form-control form-control-lg">
                                        {% for agent in fsc.tpvAgents %}
                                            {% if agent.codagente == fsc.agente.codagente %}
                                                <option value="{{ agent.codagente }}"
                                                        selected>{{ agent.getAgente(agent.codagente).nombre }}</option>
                                            {% else %}
                                                <option value="{{ agent.codagente }}">{{ agent.getAgente(agent.codagente).nombre }}</option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="form-group">
                                    {{ trans('password') }}
                                    <input type="password" name="passwd" class="form-control form-control-lg"
                                           placeholder="{{ trans('password') }}" required autofocus>
                                </div>
                                <button type="button" onclick="loginForm()" class="btn btn-block btn-lg btn-primary btn-spin-action">
                                    {{ trans('login') }}
                                </button>
                                <div class="text-center">
                                    <small class="text-secondary">{{ trans('pos-terminal') }}: {{ fsc.tpv.name }}</small>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="text-center">
                        <a href="{{ fsc.url() }}" class="btn btn-block btn-secondary">
                            <i class="fas fa-list mr-1"></i> {{ trans('pos-terminals') }}
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="col-sm-6">
                    <div class="card shadow mb-4">
                        <div class="card-body text-center">
                            <h3>
                                <i class="fas fa-user-tie fa-fw"></i>
                                {{ trans('without-agents') }}
                            </h3>
                            <p>{{ trans('without-agents-legend') }}</p>
                            <a class="btn btn-success" href="{{ asset('EditAgente') }}">
                                <i class="fas fa-plus"></i>
                                {{ trans('add-agent') }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    <iframe class="d-none" src="http://localhost:8089"></iframe>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        function loginForm() {
            animateSpinner('add');
            document.getElementById('loginForm').submit();
        }
    </script>
{% endblock %}